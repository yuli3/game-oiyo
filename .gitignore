# build output
dist/
# generated types
.astro/

# dependencies
# 슬래시가 있으면 디렉터리만 막는다. 워크트리 절차는 node_modules 를
# **심볼릭 링크**로 만들기 때문에 슬래시가 있으면 링크가 추적 후보로 남는다.
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.local
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# personal study files (not project files)
*.pdf
공기업*.md
국어논리*.md

# Generated audit reports
reports/
*.log

# Python bytecode caches
**/__pycache__/

# sprite frame harvest scratch
.tmp-frames/

# git worktree
# 워크트리는 coding/.worktrees/ (repo 바깥) 에 만든다. repo 안에 생기면 조용히
# 망가진다 — 테스트 러너가 그 안까지 수집하고, node_modules 중복이 쌓이고,
# untracked 로 노출돼 git add -A 에 딸려 들어간다.
.worktrees/

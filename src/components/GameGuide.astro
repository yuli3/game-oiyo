---
// 게임 가이드 섹션 + VideoGame/FAQPage JSON-LD (SEO·AIEO).
// 2026-11-08: game-guides.ts에 없는 슬러그도 getFallbackGameGuide로 100% VideoGame/FAQPage 구조화 데이터 및 SSR 본문 보장
// 2026-11-10: Schema.org VideoGame+SoftwareApplication 완비, 실시간 내부 추천 체인(GameHub Recommendation Chain) 확장
import { GAME_GUIDES } from "../data/game-guides";
import { GAME_INSIGHTS } from "../data/game-insights";
import { STRATEGY_GUIDES } from "../data/game-strategy";
import type { Locale } from "../lib/i18n";
import GamePlayBeacon from "./games/GamePlayBeacon";
import { getFallbackGameGuide } from "../lib/seo/game-guide-fallback";
import { videoGameJsonLd, faqPageJsonLd } from "../lib/seo/structured-data";
import { getGameRecommendations } from "../lib/games/game-recommendations";
import gameArtDocument from "../../config/game-art-v1.json";

interface Props { slug: string; locale: Locale; name: string }
const { slug, locale, name } = Astro.props;
const g = GAME_GUIDES[slug] ?? getFallbackGameGuide(slug, name);
const strategy = STRATEGY_GUIDES[slug];
const insight = GAME_INSIGHTS[slug];
const insightTitle = insight?.title[locale];
const insightParagraphs = insight?.paragraphs[locale];

const H = {
  origin: { ko: "유래와 역사", en: "Origin & history", ja: "由来と歴史", zh: "起源与历史", fr: "Origine et histoire", es: "Origen e historia" } as Record<Locale, string>,
  how: { ko: "게임 방법", en: "How to play", ja: "遊び方", zh: "玩法", fr: "Comment jouer", es: "Cómo jugar" } as Record<Locale, string>,
  rules: { ko: "자세한 규칙", en: "Detailed rules", ja: "詳しいルール", zh: "详细规则", fr: "Règles détaillées", es: "Reglas detalladas" } as Record<Locale, string>,
  faq: { ko: "자주 묻는 질문", en: "FAQ", ja: "よくある質問", zh: "常见问题", fr: "FAQ", es: "Preguntas frecuentes" } as Record<Locale, string>,
  related: { ko: "함께 읽기", en: "Related reading", ja: "あわせて読む", zh: "延伸阅读", fr: "À lire aussi", es: "Lectura relacionada" },
  recommendations: { ko: "함께 즐기기 좋은 추천 게임", en: "Recommended games to play next", ja: "あわせて楽しむおすすめゲーム", zh: "推荐畅玩游戏", fr: "Jeux recommandés", es: "Juegos recomendados" } as Record<Locale, string>,
  strategyLink: { ko: "🏆 승리 전략 가이드 보기 →", en: "🏆 See the strategy guide →", ja: "🏆 攻略ガイドを見る →", zh: "🏆 查看攻略指南 →", fr: "🏆 Voir le guide de stratégie →", es: "🏆 Ver la guía de estrategia →" } as Record<Locale, string>,
};

// 로케일별로만 조회한다. `?? related.en` 같은 폴백을 넣으면 해당 로케일에
// 없는 페이지로 보내 404가 된다.
const relatedLinks = g?.related?.[locale];
const ruleList = g?.rules ? (g.rules[locale] ?? g.rules.en) : null;
const recommendedGames = getGameRecommendations(slug, locale, 4);

// 게임 키아트 이미지 또는 og-image 절대 URL 추출
const gameArt = gameArtDocument.games as Record<string, string>;
const artPath = gameArt[slug];
const siteBase = Astro.site ?? "https://game.oiyo.net";
const imageUrl = artPath
  ? new URL(artPath, siteBase).toString()
  : new URL("/og-image.png", siteBase).toString();

const pageUrl = new URL(Astro.url.pathname, siteBase).toString();

const jsonLd = g ? [
  videoGameJsonLd({
    name,
    description: g.how[locale] ?? g.how.en,
    url: pageUrl,
    image: imageUrl,
    inLanguage: locale,
    gamePlatform: ["Web browser", "PC", "Mobile"],
    playMode: "SinglePlayer",
    isAccessibleForFree: true,
  }),
  faqPageJsonLd(g.faqs.map((f) => ({
    question: f.q[locale] ?? f.q.en,
    answer: f.a[locale] ?? f.a.en,
  }))),
] : null;
---

{/* 2026-10-13: this null-rendering beacon only records browser interactions;
    keep the guide's static HTML while avoiding unnecessary React SSR. */}
<GamePlayBeacon client:only="react" slug={slug} />
{g && (
  <>
    {jsonLd!.map((o) => <script type="application/ld+json" is:inline set:html={JSON.stringify(o)} />)}
    <section data-game-guide class="mx-auto mt-12 max-w-lg space-y-6 border-t border-border pt-8 px-1">
      <div>
        <h2 class="text-lg font-black">{H.how[locale]}</h2>
        <p class="mt-2 text-sm leading-7 text-muted-foreground">{g.how[locale] ?? g.how.en}</p>
      </div>
      {ruleList && (
        <div>
          <h2 class="text-lg font-black">{H.rules[locale]}</h2>
          <ol class="mt-2 space-y-1.5 text-sm leading-7 text-muted-foreground">
            {ruleList.map((r, i) => (
              <li class="flex gap-2"><span class="shrink-0 font-black text-primary">{i + 1}.</span><span>{r}</span></li>
            ))}
          </ol>
        </div>
      )}
      {insightTitle && insightParagraphs && (
        <div>
          <h2 class="text-lg font-black">{insightTitle}</h2>
          <div class="mt-2 space-y-3 text-sm leading-7 text-muted-foreground">
            {insightParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      )}
      <div>
        <h2 class="text-lg font-black">{H.origin[locale]}</h2>
        <p class="mt-2 text-sm leading-7 text-muted-foreground">{g.origin[locale] ?? g.origin.en}</p>
      </div>
      <div>
        <h2 class="text-lg font-black">{H.faq[locale]}</h2>
        <div class="mt-3 divide-y divide-border rounded-2xl border border-border bg-card">
          {g.faqs.map((f) => (
            <details class="group p-4">
              <summary class="cursor-pointer list-none text-sm font-bold">{f.q[locale] ?? f.q.en}</summary>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">{f.a[locale] ?? f.a.en}</p>
            </details>
          ))}
        </div>
      </div>
      {recommendedGames.length > 0 && (
        <div>
          <h2 class="text-lg font-black">{H.recommendations[locale]}</h2>
          <div class="mt-3 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
            {recommendedGames.map((rec) => (
              <a
                href={rec.href}
                class="group flex flex-col items-center justify-center rounded-xl border border-border bg-card p-3 text-center transition-colors hover:border-primary/50 hover:bg-accent/40"
              >
                <span class="text-2xl transition-transform group-hover:scale-110">{rec.emoji}</span>
                <span class="mt-1.5 text-xs font-bold text-foreground group-hover:text-primary line-clamp-1">
                  {rec.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
      {relatedLinks && relatedLinks.length > 0 && (
        <div>
          <h2 class="text-lg font-black">{H.related[locale]}</h2>
          <ul class="mt-2 space-y-1">
            {relatedLinks.map((r) => (
              <li>
                <a href={r.href} class="text-sm font-bold text-primary hover:underline">{r.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {strategy && (
        <a href={`/${locale}/${slug}-strategy/`} class="inline-block text-sm font-bold text-primary hover:underline">
          {H.strategyLink[locale]}
        </a>
      )}
    </section>
  </>
)}

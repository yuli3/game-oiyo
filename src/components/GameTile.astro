---
// One game card for the arcade home (2026-11-24 UI pass).
// The key art is shown at full colour on top and the name sits below it, because most
// key art already has the title painted in — an overlaid name doubled it and the white
// wash hid the pixel art. The chunky outline + drop (`game-card`) matches `game-btn`.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  slug: string;
  name: string;
  emoji: string;
  art?: ImageMetadata;
  /** Small label under the name (genre or a hook line). */
  tag?: string;
  /** One-line pitch; only shown on the wide shelf cards. */
  desc?: string;
  badge?: string;
  badge3d?: string;
  /** Search haystack: every locale's name + slug, lower-cased. */
  search?: string;
  cat?: string;
  variant?: "grid" | "shelf";
  sizes?: string;
}

const { href, slug, name, emoji, art, tag, desc, badge, badge3d, search, cat, variant = "grid", sizes } = Astro.props;
const shelf = variant === "shelf";
---
<a
  href={href}
  data-game={slug}
  data-tile={search !== undefined ? "" : undefined}
  data-cat={cat}
  data-search={search}
  class:list={[
    "game-card group flex flex-col overflow-hidden text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring",
    shelf ? "w-64 shrink-0 snap-start sm:w-auto" : "min-w-0",
  ]}
>
  <span class="relative block aspect-video overflow-hidden border-b-2 border-foreground bg-muted">
    {art ? (
      <Image
        src={art}
        alt=""
        width={shelf ? 640 : 480}
        widths={shelf ? [320, 640] : [240, 480]}
        sizes={sizes ?? (shelf ? "(min-width: 1024px) 280px, 256px" : "(min-width: 1024px) 220px, (min-width: 640px) 30vw, 46vw")}
        format="webp"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <span class="absolute inset-0 flex items-center justify-center bg-accent text-4xl" aria-hidden="true">{emoji}</span>
    )}
    {badge && (
      <span class="absolute top-1.5 left-1.5 rounded-sm border-2 border-foreground bg-warning px-1.5 text-xs font-black text-warning-foreground">{badge}</span>
    )}
    {badge3d && (
      <span class="absolute right-1.5 bottom-1.5 rounded-sm border-2 border-foreground bg-card px-1.5 text-xs font-black text-foreground">{badge3d}</span>
    )}
    <span data-winrate hidden class="absolute top-1.5 right-1.5 rounded-sm border-2 border-foreground bg-card px-1.5 text-xs font-black text-primary"></span>
  </span>
  <span class:list={["flex min-w-0 flex-1 flex-col gap-0.5", shelf ? "p-3" : "px-2.5 py-2"]}>
    <span class="flex min-w-0 items-center gap-1.5">
      <span aria-hidden="true" class="shrink-0 text-base">{emoji}</span>
      <span class:list={["truncate font-black text-foreground group-hover:text-primary", shelf ? "text-base" : "text-sm"]}>{name}</span>
    </span>
    {tag && <span class="truncate text-xs font-semibold text-muted-foreground">{tag}</span>}
    {desc && <span class="line-clamp-2 text-xs leading-relaxed text-muted-foreground">{desc}</span>}
  </span>
</a>

---
/**
 * PWA: registers public/sw.js and offers "install the app".
 *
 * The card shows by itself only on the arcade home, only for a returning
 * visitor (second day or later), and not again for 30 days after "Later".
 * Chrome/Edge/Android get the native install prompt; iPhone/iPad Safari, which
 * has none, get the Share → Add to Home Screen hint. The footer button appears
 * on every page whenever the browser can install.
 */
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  auto?: boolean;
}

const { locale, auto = false } = Astro.props as Props;

const copy: Record<Locale, { title: string; body: string; install: string; later: string; ios: string }> = {
  ko: { title: "OIYO 아케이드를 앱으로", body: "홈 화면에서 바로 열리고, 한 번 연 게임은 인터넷이 없어도 열려요.", install: "설치", later: "나중에", ios: "Safari 아래쪽 공유 버튼을 누른 뒤 ‘홈 화면에 추가’를 고르세요." },
  en: { title: "Get OIYO Arcade as an app", body: "Open it from your home screen. Games you opened once also work offline.", install: "Install", later: "Later", ios: "Tap the Share button in Safari, then choose “Add to Home Screen”." },
  ja: { title: "OIYO アーケードをアプリに", body: "ホーム画面からすぐ開けます。一度開いたゲームはオフラインでも遊べます。", install: "インストール", later: "あとで", ios: "Safari の共有ボタンを押し、「ホーム画面に追加」を選んでください。" },
  zh: { title: "把 OIYO 街机装成应用", body: "从主屏幕直接打开，打开过的游戏离线也能玩。", install: "安装", later: "以后再说", ios: "点按 Safari 的分享按钮，然后选择“添加到主屏幕”。" },
  fr: { title: "OIYO Arcade en application", body: "Ouvrez-la depuis l'écran d'accueil. Un jeu ouvert une fois marche aussi hors ligne.", install: "Installer", later: "Plus tard", ios: "Touchez le bouton Partager de Safari, puis « Sur l'écran d'accueil »." },
  es: { title: "OIYO Arcade como app", body: "Ábrela desde la pantalla de inicio. Los juegos que abriste una vez funcionan sin conexión.", install: "Instalar", later: "Más tarde", ios: "Toca el botón Compartir de Safari y elige «Añadir a pantalla de inicio»." },
};
const t = copy[locale] ?? copy.en;
---

<div
  class="fixed inset-x-4 bottom-4 z-40 mx-auto max-w-sm rounded-2xl border border-border bg-card p-4 text-card-foreground shadow-2xl sm:left-4 sm:right-auto sm:mx-0"
  role="dialog"
  aria-labelledby="pwa-install-title"
  data-pwa-install
  data-auto={auto ? "1" : undefined}
  hidden
>
  <div class="flex items-start gap-3">
    <img src="/icon-192.png" alt="" width="48" height="48" class="size-12 shrink-0 rounded-xl" loading="lazy" decoding="async" />
    <div class="min-w-0 flex-1">
      <p id="pwa-install-title" class="m-0 font-bold">{t.title}</p>
      <p class="m-0 mt-1 text-sm text-muted-foreground">{t.body}</p>
      <p class="m-0 mt-2 text-sm font-semibold" data-pwa-ios hidden>{t.ios}</p>
    </div>
  </div>
  <div class="mt-3 flex justify-end gap-2">
    <button type="button" class="inline-flex min-h-11 items-center rounded-full border border-border px-4 py-2 text-sm font-bold text-foreground cursor-pointer" data-pwa-dismiss>{t.later}</button>
    <button type="button" class="inline-flex min-h-11 items-center rounded-full bg-primary px-5 py-2 text-sm font-extrabold text-primary-foreground cursor-pointer" data-pwa-install-button>{t.install}</button>
  </div>
</div>

<script>
  import { initPwa } from "../lib/pwa/client";
  initPwa();
</script>

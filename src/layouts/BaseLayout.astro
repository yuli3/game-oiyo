---
import SEO from "../components/SEO.astro";
import { getLocaleFromPath, getTranslations } from "../lib/i18n";
import { siteConfig } from "../config/site.config";
import "../styles/global.css";
import "katex/dist/katex.min.css";
import "@fontsource-variable/inter";
import AhoxyWelcome from '../components/AhoxyWelcome.astro';

// BCP-47 mapping: Astro locale → HTML lang attribute standard value
const BCP47: Record<string, string> = {
  en: "en", ko: "ko", ja: "ja", fr: "fr", es: "es",
  zh: "zh-CN", // cn folder = Traditional Chinese
};

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  category?: string;
  author?: string;
  availableLocales?: string[];
  canonicalUrl?: string;
  /**
   * 페이지 최상단 `<h1>`. 옵트인인 이유는 전략/도구 페이지가 이미 자기
   * 컴포넌트에서 h1 을 렌더하기 때문이다 — 무조건 켜면 h1 이 두 개가 된다.
   * 게임 페이지는 `<title>` 만 있고 본문 첫 헤딩이 GameGuide 의 h2 라서
   * 2026-07-27 감사에서 로케일 페이지 354개 중 306개가 h1 없이 나갔다.
   */
  heading?: string;
}

const { title, description, image, type, pubDate, updatedDate, tags, category, author, availableLocales, canonicalUrl, heading } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = await getTranslations(locale);
const nav = t.nav as Record<string, string>;

const scrollSnapEnabled = siteConfig.features.scrollSnap;

// Helper to generate localized path preserving current slug
const locales = siteConfig.locales;
const currentPathname = Astro.url.pathname;

const getLocalizedPath = (targetLocale: string) => {
  const firstSegment = currentPathname.split("/")[1];

  // Locale-less pages (e.g. /knowledge) have no per-locale variants; keep them
  // self-referential so the switcher never points to a non-existent /xx/ copy.
  if (!locales.includes(firstSegment)) {
    return currentPathname;
  }
  const restOfPath = currentPathname.replace(`/${firstSegment}`, "");
  const localizedPath = `/${targetLocale}${restOfPath}` || "/";
  return localizedPath.startsWith("/") ? localizedPath : `/${localizedPath}`;
};

// game.oiyo.net nav — local pages only; cross-domain family links are absolute
const navItems = [
  { href: `/${locale}/`, label: (({ ko: "아케이드", ja: "アーケード", zh: "街机", fr: "Arcade", es: "Arcade", en: "Arcade" } as Record<string, string>)[locale] ?? "Arcade") },
  { href: `/${locale}/achievements`, label: (({ ko: "🏆 업적", ja: "🏆 実績", zh: "🏆 成就", fr: "🏆 Succès", es: "🏆 Logros", en: "🏆 Achievements" } as Record<string, string>)[locale] ?? "🏆 Achievements") },
  { href: `https://blog.oiyo.net/${locale}/tools`, label: nav.tools ?? "Tools" },
  { href: `https://blog.oiyo.net/${locale}/magazine`, label: nav.magazine ?? "Magazine" },
  { href: `https://oiyo.net/${locale}/`, label: "OIYO" },
];

// Sister sites for family nav (footer + hamburger drawer).
// news is a single-locale (ko) site — it has no /{locale}/ routes, so
// appending the locale path would land on their 404 page.
const FAMILY = [
  { host: "oiyo.net", name: "OIYO tests", localePath: true, tag: { ko: "테스트·도구", en: "Tests & tools", ja: "テスト・ツール", zh: "测验·工具", fr: "Tests et outils", es: "Tests y herramientas" } },
  { host: "blog.oiyo.net", name: "OIYO blog", localePath: true, tag: { ko: "강의·매거진", en: "Guides & magazine", ja: "講座・マガジン", zh: "课程·杂志", fr: "Guides et magazine", es: "Guías y revista" } },
  { host: "wiki.oiyo.net", name: "OIYO wiki", localePath: true, tag: { ko: "정의·참고 자료", en: "Definitions & reference", ja: "定義・参考資料", zh: "定义·参考资料", fr: "Définitions et références", es: "Definiciones y referencias" } },
  { host: "game.oiyo.net", name: "OIYO game", localePath: true, tag: { ko: "게임", en: "Games", ja: "ゲーム", zh: "游戏", fr: "Jeux", es: "Juegos" } },
  { host: "news.oiyo.net", name: "OIYO news", localePath: false, tag: { ko: "뉴스·AI", en: "News & AI", ja: "ニュース・AI", zh: "新闻·AI", fr: "Actualités et IA", es: "Noticias e IA" } },
];
const familyHref = (f: (typeof FAMILY)[number], medium: string) =>
  `https://${f.host}/${f.localePath ? `${locale}/` : ""}?utm_source=game&utm_medium=${medium}&utm_campaign=family_nav`;

const allLangItems = [
  { code: "en", label: "EN" },
  { code: "ko", label: "KO" },
  { code: "ja", label: "JA" },
  { code: "fr", label: "FR" },
  { code: "es", label: "ES" },
  { code: "zh", label: "ZH" },
];
// Only offer locales the current page actually exists in (article pages pass
// availableLocales); fall back to all. cn is removed from routing entirely.
const langItems = availableLocales && availableLocales.length
  ? allLangItems.filter((li) => availableLocales.includes(li.code) || li.code === locale)
  : allLangItems;
const copy: Record<string, { arcade: string; info: string; family: string; sitemap: string; support: string; home: string }> = {
  en: { arcade: "Arcade", info: "Information", family: "OIYO family", sitemap: "Sitemap", support: "Support OIYO", home: "Arcade" },
  ko: { arcade: "아케이드", info: "안내", family: "OIYO 패밀리", sitemap: "사이트맵", support: "OIYO 후원", home: "아케이드" },
  ja: { arcade: "アーケード", info: "ご案内", family: "OIYOファミリー", sitemap: "サイトマップ", support: "OIYOを支援", home: "アーケード" },
  zh: { arcade: "街机", info: "信息", family: "OIYO 系列", sitemap: "网站地图", support: "支持 OIYO", home: "街机" },
  fr: { arcade: "Arcade", info: "Informations", family: "Famille OIYO", sitemap: "Plan du site", support: "Soutenir OIYO", home: "Arcade" },
  es: { arcade: "Arcade", info: "Información", family: "Familia OIYO", sitemap: "Mapa del sitio", support: "Apoyar OIYO", home: "Arcade" },
};
const labels = copy[locale] ?? copy.en;
---

<html
  lang={BCP47[locale] ?? locale}
  class:list={["scroll-smooth", { "snap-y snap-mandatory": scrollSnapEnabled }]}
>
  <head>
    <SEO {title} {description} {image} {type} {pubDate} {updatedDate} {tags} {category} {author} {availableLocales} canonicalURL={canonicalUrl} />

    <!-- Mermaid diagram rendering (only executes if mermaid code blocks are present) -->
    <script type="module" is:inline>
      if (document.querySelector("code.language-mermaid")) {
        const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
        mermaid.initialize({ startOnLoad: false, theme: "neutral", securityLevel: "strict" });
        document.querySelectorAll("code.language-mermaid").forEach((el) => {
          const pre = el.parentElement;
          if (!pre) return;
          const div = document.createElement("div");
          div.className = "mermaid not-prose my-8";
          div.textContent = el.textContent;
          pre.replaceWith(div);
        });
        await mermaid.run();
      }
    </script>
  </head>
  <body
    class="min-h-screen bg-background text-foreground font-sans antialiased text-pretty selection:bg-primary/20 selection:text-primary"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] bg-primary text-primary-foreground px-4 py-2 rounded-lg"
    >
      Skip to content
    </a>

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <header
      role="banner"
      class="sticky top-0 z-50 w-full border-b bg-background"
    >
      <div class="container flex h-16 items-center justify-between px-4">

        <!-- Schema.org structured data for navigation -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "SiteNavigationElement",
          "hasPart": navItems.map(item => ({
            "@type": "WebPage",
            "name": item.label,
            "url": `${siteConfig.url}${item.href}`,
          })),
        })} />

        <!-- Logo -->
        <a
          href={`/${locale}/`}
          class="flex items-center space-x-2 shrink-0 z-10"
          aria-label="Oiyo home"
        >
          <span class="font-black text-xl tracking-tighter text-foreground">OIYO</span><span class="text-sm font-semibold lowercase tracking-wide text-primary">game</span>
        </a>

        <!-- Desktop nav (lg+) -->
        <nav
          aria-label="Main navigation"
          class="hidden lg:flex gap-6 items-center"
        >

          <!-- Language switcher -->
          <div class="flex items-center gap-2 border-l border-border/40 pl-4">
            {langItems.map(({ code, label }) => (
              <a
                href={getLocalizedPath(code)}
                class={`text-[11px] font-bold uppercase tracking-widest transition-colors hover:text-primary ${locale === code ? "text-primary" : "text-muted-foreground/70"}`}
              >{label}</a>
            ))}
          </div>
        </nav>

        <!-- Right controls: hamburger -->
        <div class="flex items-center gap-2">

          <!-- Hamburger (mobile only) -->
          <button
            id="menu-open"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Reading progress — anchored to the header's bottom edge so it never floats over content -->
      <div
        id="reading-progress"
        class="absolute bottom-0 left-0 h-0.5 bg-primary transition-none"
        style="width: 0%"
        aria-hidden="true"
      ></div>
    </header>

    <!-- ── Mobile menu overlay ───────────────────────────────────────────── -->
    <div
      id="mobile-menu-overlay"
      class="fixed inset-0 z-[60] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-hidden="true"
    ></div>

    <!-- Mobile menu drawer (slides in from right) -->
    <div
      id="mobile-menu"
      role="dialog"
      aria-label="Navigation menu"
      aria-modal="true"
      class="fixed top-0 right-0 h-full w-72 max-w-[85vw] z-[70] bg-background border-l border-border shadow-2xl translate-x-full transition-transform duration-300 ease-out flex flex-col"
    >
      <!-- Drawer header -->
      <div class="flex items-center justify-between px-6 h-16 border-b border-border/40 shrink-0">
        <span class="font-black text-lg tracking-tighter">OIYO <span class="font-semibold lowercase text-primary">game</span></span>
        <button
          id="menu-close"
          aria-label="Close menu"
          class="flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/60 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <!-- Nav links -->
      <nav aria-label="Mobile navigation" class="flex-1 overflow-y-auto px-6 py-6 space-y-1">
        {navItems.map(({ href, label }) => (
          <a
            href={href}
            class="flex items-center h-11 px-2 rounded-lg text-sm font-bold uppercase tracking-widest text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors"
          >{label}</a>
        ))}
        <div class="pt-2 border-t border-border/40 mt-4">
          <p class="px-2 pt-2 pb-1 text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50">Oiyo Family</p>
          {FAMILY.map((f) => (
            <a
              href={familyHref(f, "menu")}
              target="_blank" rel="noopener noreferrer"
              class="flex flex-col justify-center min-h-11 px-2 py-1.5 rounded-lg text-sm font-bold text-muted-foreground hover:text-primary hover:bg-muted/40 transition-colors"
            >
              <span class="uppercase tracking-widest">{f.name} ↗</span>
              <span class="text-[11px] font-normal normal-case tracking-normal opacity-70">{f.tag[locale as keyof typeof f.tag] ?? f.tag.en}</span>
            </a>
          ))}
        </div>
      </nav>

      <!-- Language switcher at bottom -->
      <div class="px-6 pb-6 pt-4 border-t border-border/40 shrink-0">
        <p class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/50 mb-3">
          {t.common?.selectLanguage ?? "Language"}
        </p>
        <div class="flex flex-wrap gap-2">
          {langItems.map(({ code, label }) => (
            <a
              href={getLocalizedPath(code)}
              class={`px-3 py-1.5 rounded-md text-xs font-bold uppercase tracking-widest border transition-colors ${locale === code ? "bg-primary text-primary-foreground border-primary" : "border-border text-muted-foreground hover:text-primary hover:border-primary/40"}`}
            >{label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Interactive scripts (inline to avoid render-blocking) -->
    <script is:inline>
      // ── Reading progress ──────────────────────────────────────────────────
      (function () {
        var bar = document.getElementById("reading-progress");
        if (!bar) return;
        function update() {
          var scrollTop = window.scrollY || document.documentElement.scrollTop;
          var docHeight =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          bar.style.width = Math.min(100, pct).toFixed(1) + "%";
        }
        window.addEventListener("scroll", update, { passive: true });
        update();
      })();

      // ── Back to top ──────────────────────────────────────────────────────
      (function () {
        var btn = document.getElementById("back-to-top");
        if (!btn) return;
        function toggleVisibility() {
          var show = window.scrollY > 400;
          btn.classList.toggle("opacity-0", !show);
          btn.classList.toggle("pointer-events-none", !show);
          btn.classList.toggle("opacity-100", show);
        }
        window.addEventListener("scroll", toggleVisibility, { passive: true });
        btn.addEventListener("click", function () {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
        toggleVisibility();
      })();

      // ── Mobile menu ───────────────────────────────────────────────────────
      (function () {
        var openBtn   = document.getElementById("menu-open");
        var closeBtn  = document.getElementById("menu-close");
        var overlay   = document.getElementById("mobile-menu-overlay");
        var drawer    = document.getElementById("mobile-menu");
        if (!openBtn || !closeBtn || !overlay || !drawer) return;

        function openMenu() {
          drawer.classList.remove("translate-x-full");
          overlay.classList.remove("opacity-0", "pointer-events-none");
          overlay.classList.add("opacity-100");
          overlay.setAttribute("aria-hidden", "false");
          openBtn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
          // Move focus into drawer
          var firstLink = drawer.querySelector("a, button");
          if (firstLink) firstLink.focus();
        }

        function closeMenu() {
          drawer.classList.add("translate-x-full");
          overlay.classList.add("opacity-0", "pointer-events-none");
          overlay.classList.remove("opacity-100");
          overlay.setAttribute("aria-hidden", "true");
          openBtn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
          openBtn.focus();
        }

        openBtn.addEventListener("click", openMenu);
        closeBtn.addEventListener("click", closeMenu);
        overlay.addEventListener("click", closeMenu);

        // Escape key closes menu
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") closeMenu();
        });
      })();
    </script>

    <main id="main-content" role="main" class="flex-1">
      {heading && (
        <div class="mx-auto max-w-2xl px-4 pt-5">
          <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-xs text-muted-foreground"><a href={`/${locale}/`} class="hover:text-primary hover:underline">{labels.home}</a><span aria-hidden="true">/</span><span aria-current="page" class="truncate">{heading}</span></nav>
          <h1 class="text-2xl font-black tracking-tight text-foreground">{heading}</h1>
        </div>
      )}
      <slot />
    </main>

    <!-- Back to top button -->
    <button
      id="back-to-top"
      aria-label={t.common?.goToTop ?? "Go to top"}
      class="fixed bottom-6 right-6 z-40 h-10 w-10 rounded-full bg-primary text-primary-foreground shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-200 hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <footer class="border-t border-border bg-muted/25 py-10 text-left">
      <div class="container grid gap-8 px-4 sm:grid-cols-2 lg:grid-cols-[0.8fr_1fr_2fr]">
        <section><p class="mb-3 text-sm font-black">OIYO <span class="font-semibold lowercase text-primary">game</span></p><nav aria-label={labels.arcade} class="grid gap-2 text-sm text-muted-foreground"><a href={`/${locale}/`} class="hover:text-primary">{labels.arcade}</a><a href={`/${locale}/achievements`} class="hover:text-primary">{navItems[1].label}</a><a href={`/${locale}/chess/`} class="hover:text-primary">Chess</a><a href={`/${locale}/sudoku/`} class="hover:text-primary">Sudoku</a></nav></section>
        <section><p class="mb-3 text-xs font-bold uppercase tracking-widest">{labels.info}</p><nav aria-label={labels.info} class="grid gap-2 text-sm text-muted-foreground"><a href="/sitemap-index.xml" class="hover:text-primary">{labels.sitemap}</a><a href={`https://blog.oiyo.net/${locale}/privacy`} class="hover:text-primary">{t.legal.privacy.title}</a><a href={`https://blog.oiyo.net/${locale}/terms`} class="hover:text-primary">{t.legal.terms.title}</a><a href="https://paypal.me/chosean" class="hover:text-primary">{labels.support}</a></nav></section>
        <section><p class="mb-3 text-xs font-bold uppercase tracking-widest">{labels.family}</p><nav aria-label={labels.family} class="grid grid-cols-2 gap-x-5 gap-y-3 sm:grid-cols-3">{FAMILY.map((f) => (<a href={familyHref(f, "footer")} class="group text-sm font-semibold hover:text-primary">{f.name}<span class="block text-xs font-normal text-muted-foreground">{f.tag[locale as keyof typeof f.tag] ?? f.tag.en}</span></a>))}</nav></section>
      </div>
      <div class="container mt-8 flex justify-between border-t border-border px-4 pt-5 text-xs text-muted-foreground"><span>© {new Date().getFullYear()} Oiyo Tech</span><a href="mailto:support@oiyo.net">support@oiyo.net</a></div>
    </footer>
    <AhoxyWelcome locale={locale} />
  </body>
</html>

---
import UnityMainShell from "../../components/games/UnityMainShell.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GrapplingBoss from "../../components/games/GrapplingBoss";
import GameGuide from "../../components/GameGuide.astro";
import { locales, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l } }));
}

const locale: Locale = (Astro.params.lang as Locale) || "en";

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "그래플링 보스 아레나 — 갈고리 스윙 보스전 20단계 | OIYO Game",
    description:
      "갈고리를 천장 앵커에 걸어 진자처럼 날아다니며 촉수 4개를 휘두르는 기계 감시자 아이언 게이저와 싸우세요. 이길 때마다 더 강한 보스가 나오는 20단계 보스전입니다.",
  },
  en: {
    title: "Grappling Boss Arena — 20-Tier Grapple Swing Boss Fight | OIYO Game",
    description:
      "Swing from ceiling anchors on a grappling hook and take down the Iron Gazer, a mechanical sentinel with four IK tentacles. Each win unlocks a tougher rematch across 20 boss tiers.",
  },
  ja: {
    title: "グラップリング・ボスアリーナ — 鉤縄スイングのボス戦20ステージ | OIYO Game",
    description:
      "鉤縄で天井のアンカーにぶら下がって振り子のように飛び回り、4本の触手を持つ機械の番人アイアン・ゲイザーと戦います。勝つたびに強くなる20段階のボス戦です。",
  },
  zh: {
    title: "抓钩首领竞技场 — 荡绳首领战 20 关 | OIYO Game",
    description:
      "用抓钩挂上天花板锚点像钟摆一样飞荡，迎战拥有 4 根触手的机械守卫“铁之凝视者”。每次获胜都会解锁更强的首领，共 20 关。",
  },
  fr: {
    title: "Grappling Boss Arena — Combat de boss au grappin en 20 niveaux | OIYO Game",
    description:
      "Balancez-vous d'ancre en ancre avec votre grappin et abattez l'Iron Gazer, sentinelle mécanique aux quatre tentacules. Chaque victoire débloque un boss plus coriace, sur 20 niveaux.",
  },
  es: {
    title: "Arena del Jefe con Gancho — Combate de jefe en 20 niveles | OIYO Game",
    description:
      "Balancéate de ancla en ancla con tu gancho y derriba al Iron Gazer, un centinela mecánico con cuatro tentáculos. Cada victoria desbloquea un jefe más duro, en 20 niveles.",
  },
};

const m = meta[locale] || meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title}>
  <UnityMainShell slug="grappling-boss" build="grappling-boss-unity" locale={locale} name={m.title.split(" — ")[0]} poster="/games/unity-posters/grappling-boss.webp">
    <GrapplingBoss client:visible locale={locale} />
  </UnityMainShell>
  <div class="mx-auto max-w-3xl px-4 mt-8">
    <GameGuide slug="grappling-boss" locale={locale} name={m.title.split(" — ")[0]} />
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TamagotchiComp from "../../components/games/Tamagotchi";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "포켓 펫 — 무료 온라인 픽셀 가상 펫",
    description: "다마고치 같은 LCD 가상 펫. 레트로 LCD 감성의 픽셀 다마고치를 키워보세요. 알에서 부화해 4단계로 성장하고, 식사 시간과 산책까지 챙겨야 하는 진짜 육성 게임입니다.",
  },
  en: {
    title: "Pocket Pet — Free Online Pixel Virtual Pet",
    description: "A Tamagotchi-style LCD virtual pet. Raise a retro LCD-style pixel pet. Hatch it from an egg, grow it through 4 stages, and keep up with real meal times and walks — real care required.",
  },
  ja: {
    title: "ポケットペット — 無料オンラインピクセル育成",
    description: "たまごっちのようなLCDペット育成。 レトロLCD風のピクセルペットを育てよう。たまごから孵化して4段階に成長。食事の時間や散歩まで世話が必要な本格育成ゲーム。",
  },
  fr: {
    title: "Pocket Pet — Animal virtuel pixel gratuit en ligne",
    description: "Un animal virtuel LCD façon Tamagotchi. Élevez un compagnon pixel façon LCD rétro : éclosion, 4 stades de croissance, repas à heures fixes et promenades — de vrais soins requis.",
  },
  es: {
    title: "Pocket Pet — Mascota virtual pixel gratis en línea",
    description: "Una mascota virtual LCD al estilo Tamagotchi. Cría una mascota pixel estilo LCD retro: eclosiona el huevo, crece en 4 etapas y cumple horarios reales de comida y paseos.",
  },
  zh: {
    title: "口袋宠物 — 免费在线像素养成游戏",
    description: "类似拓麻歌子的 LCD 电子宠物。 养一只复古LCD风格的像素宠物：从蛋孵化、四阶段成长，还要按时吃饭和散步——需要真正的照顾。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title}>
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <TamagotchiComp client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="pocket-pet" locale={locale} name={m.title.split(' — ')[0].split(' | ')[0]} />
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gameArtDocument from "../../../config/game-art-v1.json";
import KingdominoComp from "../../components/games/Kingdomino";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "킹덤 타일 — 도미노로 왕국을 짓는 전략 보드 게임",
    description: "킹도미노와 비슷한 방식의 타일 왕국 짓기. 지형 도미노를 골라 5×5 왕국을 넓히고, 같은 지형이 이어진 영역의 크기 × 왕관 수로 점수를 겨루는 전략 보드 게임입니다.",
  },
  en: {
    title: "Kingdom Tiles — Build a Kingdom from Terrain Dominoes",
    description: "A Kingdomino-style tile kingdom builder. Draft terrain dominoes to grow a 5×5 kingdom and score each connected region by its size times its crowns.",
  },
  ja: {
    title: "キングダムタイル — ドミノで王国を築く戦略ボードゲーム",
    description: "キングドミノ方式のタイル王国づくり。地形ドミノを選んで5×5の王国を広げ、同じ地形が繋がった領域の広さ×王冠数で得点を競う戦略ゲームです。",
  },
  fr: {
    title: "Kingdom Tiles — Bâtissez un royaume avec des dominos de terrain",
    description: "Un jeu de royaume à tuiles façon Kingdomino. Draftez des dominos de terrain pour agrandir un royaume 5×5 et marquez chaque région par sa taille multipliée par ses couronnes.",
  },
  es: {
    title: "Kingdom Tiles — Construye un reino con fichas de terreno",
    description: "Un juego de reino con fichas al estilo Kingdomino. Reclama fichas de terreno para ampliar un reino de 5×5 y puntúa cada región por su tamaño multiplicado por sus coronas.",
  },
  zh: {
    title: "王国拼砖 — 用骨牌建造王国的策略棋盘游戏",
    description: "类似 Kingdomino（王国骨牌）的拼砖建国游戏。占取地形骨牌扩展 5×5 王国，按同类地形连通区域的面积×王冠数计分的策略游戏。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image={gameArtDocument.games["kingdom-tiles"]}>
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <KingdominoComp client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="kingdom-tiles" locale={locale} name={m.title.split(' — ')[0].split(' | ')[0]} />
    </div>
  </div>
</BaseLayout>

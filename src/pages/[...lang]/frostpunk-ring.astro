---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FrostpunkRing from "../../components/games/FrostpunkRing";
import GameGuide from "../../components/GameGuide.astro";
import { locales, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l === "en" ? undefined : l } }));
}

const locale: Locale = (Astro.params.lang as Locale) || "en";

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "프로스트펑크 열기 도시 — 증기 발전기 동심원 생존 건설 | OIYO Game",
    description:
      "중앙 증기 발전기를 둘러싼 4개의 동심원 열기 구역에 석탄 파쇄기·보온 합숙소·의무실을 배치하고 -70°C 대폭설 화이트아웃을 생존하세요.",
  },
  en: {
    title: "Frostpunk Heat Ring City — Steam Generator Survival Builder | OIYO Game",
    description:
      "Build bunkhouses, coal thumpers, and infirmaries across 4 concentric heat rings around the Central Steam Generator to survive the -70°C Great Whiteout.",
  },
  ja: {
    title: "フロストパンク熱気都市 — 蒸気ジェネレーター同心円サバイバル建設 | OIYO Game",
    description:
      "中央蒸気ジェネレーターの周囲4つの同心円リングに炭鉱・宿舎・救護所を建設し、-70℃の大寒波ホワイトアウトを生き延びよう。",
  },
  zh: {
    title: "冰汽时代热环之城 — 蒸汽核心同心圆生存建造 | OIYO Game",
    description:
      "围绕中央蒸汽发生器的四层同心热力环建造采煤机、保温宿舍与医务所，颁布法典并顶住 -70°C 的大暴雪白化天灾。",
  },
  fr: {
    title: "Frostpunk Heat Ring City — Survie et Construction Thermique | OIYO Game",
    description:
      "Construisez dortoirs, mines de charbon et infirmeries sur 4 anneaux thermiques concentriques pour survivre au blizzard à -70°C.",
  },
  es: {
    title: "Frostpunk Heat Ring City — Construcción y Supervivencia Térmica | OIYO Game",
    description:
      "Construye barracones, minas de carbón y enfermerías en 4 anillos térmicos concéntricos para sobrevivir a la ventisca de -70°C.",
  },
};

const m = meta[locale] || meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title}>
  <FrostpunkRing client:load locale={locale} />
  <GameGuide slug="frostpunk-ring" locale={locale} name={m.title.split(" — ")[0]} />
</BaseLayout>

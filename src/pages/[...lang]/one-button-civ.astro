---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OneButtonCiv from "../../components/games/OneButtonCiv";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "버튼 하나짜리 문명 — 원버튼으로 섬 마을을 도시로",
    description: "버튼은 하나. 섬을 도는 일꾼 발밑에 계절마다 밭·길·성벽을 지어 마을을 키우고 약탈선을 막으세요. 30개의 섬. 무료, 설치 없이 바로.",
  },
  en: {
    title: "One-Button Realm — grow an island city with one button",
    description: "One button. Build fields, roads and walls under a walker circling the island as the seasons turn, grow the village and stop the raiders. 30 islands. Free, no install.",
  },
  ja: {
    title: "ボタン一つの文明 — ワンボタンで島の村を都市に",
    description: "ボタンは一つ。島を回る働き手の足元に季節ごとに畑・道・城壁を建て、村を育てて略奪船を防ぎましょう。30の島。無料、インストール不要。",
  },
  zh: {
    title: "一个按钮的文明 — 用一个按钮把小岛村庄变成城市",
    description: "只有一个按钮。随季节在绕岛工人脚下建田、路、城墙，发展村庄、挡住海盗船。30座岛。免费，无需安装。",
  },
  fr: {
    title: "Civilisation à un bouton — une ville d'île avec un seul bouton",
    description: "Un bouton. Bâtissez champs, routes et murailles sous un marcheur qui fait le tour de l'île au fil des saisons, faites grandir le village et repoussez les pillards. 30 îles. Gratuit.",
  },
  es: {
    title: "Civilización de un botón — una ciudad isleña con un solo botón",
    description: "Un botón. Construye campos, caminos y murallas bajo un caminante que rodea la isla según la estación, haz crecer la aldea y frena a los saqueadores. 30 islas. Gratis.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image="/assets/sprites/one-button-civ/keyart.webp">
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <OneButtonCiv client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="one-button-civ" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

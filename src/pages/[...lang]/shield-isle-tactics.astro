---
import UnityMainShell from "../../components/games/UnityMainShell.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BadNorthTactics from "../../components/games/BadNorthTactics";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta = {
  ko: {
    title: "실드 아일 택틱스 — 바이킹 침략선 상륙 저지 & 실시간 섬 방어 미니멀 RTS",
    description: "아름다운 3D 고립 섬 디오라마에서 보병, 궁병, 창병 분대를 지휘하여 사방에서 상륙하는 바이킹 침략자들로부터 가옥을 지키는 실시간 전술 디펜스 게임."
  },
  en: {
    title: "Shield Isle Tactics — Viking Longship Island Defense RTS",
    description: "Command infantry, archers, and pikemen to defend charming procedural island diorama cottages against invading Viking longships."
  },
  ja: {
    title: "シールド島戦術 — 孤島防衛ミニマルリアルタイム戦術RTS",
    description: "孤島のジオラマで歩兵・弓兵・槍兵の部隊を指揮し、四方から上陸するバイキング略奪船から家々を守り抜くミニマルリアルタイム戦術ゲーム。"
  },
  zh: {
    title: "盾岛战术 — 维京海盗孤岛微操防守 RTS",
    description: "在精致的 3D 孤岛立体微缩模型上调遣步兵、弓兵与枪兵，击退自海面乘船突袭的维京海盗，誓死守卫海岛村庄家园。"
  },
  fr: {
    title: "Shield Isle Tactics — Stratégie tactique de défense d'île contre les Vikings",
    description: "Commandez vos fantassins, archers et piquiers sur de magnifiques îles dioramas pour repousser les drakkars vikings."
  },
  es: {
    title: "Shield Isle Tactics — Táctica de defensa de islas en tiempo real",
    description: "Comanda infantería, arqueros y piqueros en dioramas insulares 3D para defender casas costeras contra los invasores vikingos."
  }
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title}>
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <UnityMainShell slug="shield-isle-tactics" build="bad-north-tactics-unity" locale={locale} name={m.title.split(" — ")[0]} poster={undefined}>
      <BadNorthTactics client:visible locale={locale} />
    </UnityMainShell>
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="shield-isle-tactics" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

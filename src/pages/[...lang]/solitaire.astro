---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gameArtDocument from "../../../config/game-art-v1.json";
import SolitaireComp from "../../components/games/Solitaire";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "솔리테어 — 매일 새로운 데일리 클론다이크",
    description: "매일 모두에게 같은 판이 주어지는 데일리 솔리테어예요. 연속 기록과 최단 시간이 남고, 자유 플레이로 새 판도 뽑을 수 있어요. 무료이고 로그인 없이 바로 해요.",
  },
  en: {
    title: "Solitaire — Free Daily Klondike Deal",
    description: "A new Klondike Solitaire deal every day, the same for everyone, with streak and best-time tracking. Free play deals a fresh game any time. Free, no login.",
  },
  ja: {
    title: "ソリティア — 毎日更新のデイリークロンダイク",
    description: "毎日、全員に同じ配り札が届くデイリーソリティアです。連続記録とベストタイムが残り、フリープレイで新しい配り札も引けます。無料・ログイン不要です。",
  },
  fr: {
    title: "Solitaire — Donne Klondike quotidienne gratuite",
    description: "Une nouvelle donne de Solitaire Klondike chaque jour, la même pour tout le monde, avec suivi de série et de meilleur temps. Le mode libre distribue une nouvelle partie à tout moment. Gratuit, sans inscription.",
  },
  es: {
    title: "Solitario — Reparto Klondike diario gratis",
    description: "Un nuevo reparto de Solitario Klondike cada día, el mismo para todos, con racha y mejor tiempo. El modo libre reparte una partida nueva cuando quieras. Gratis y sin registro.",
  },
  zh: {
    title: "接龙 — 每日更新的克朗代克牌局",
    description: "每天一局所有人相同的每日接龙，记录连续天数和最快用时。自由模式可随时开新局。免费，无需登录。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image={gameArtDocument.games.solitaire}>
  <div class="mx-auto max-w-2xl px-4 py-8">
    <SolitaireComp client:only="react" locale={locale} />
    <GameGuide slug="solitaire" locale={locale} name={m.title.split(' — ')[0].split(' | ')[0]} />
  </div>
</BaseLayout>

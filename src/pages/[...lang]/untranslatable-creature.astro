---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UntranslatableCreature from "../../components/games/UntranslatableCreature";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "번역 불가능한 생물 — 리듬으로 대화하는 따라 치기 게임",
    description: "말 대신 배를 두드려 리듬으로 말하는 생물. 들은 리듬을 박자에 맞춰 똑같이 두드려 대답하세요. 30번의 만남, 점점 길고 빨라지는 리듬. 무료, 설치 없이 바로.",
  },
  en: {
    title: "Untranslatable Creature — a call-and-response rhythm game",
    description: "A creature that talks by drumming its belly. Tap its rhythm back in time to answer. 30 meetings with longer, faster phrases. Free, no install.",
  },
  ja: {
    title: "翻訳できない生き物 — リズムで会話するまねっこゲーム",
    description: "言葉の代わりにお腹をたたいてリズムで話す生き物。聞いたリズムを拍に合わせてまねして答えましょう。30回の出会い、だんだん長く速くなるリズム。無料・インストール不要。",
  },
  zh: {
    title: "无法翻译的生物 — 用节奏对话的跟敲游戏",
    description: "一只拍肚子用节奏说话的小生物。按节拍把听到的节奏原样敲回去来回答。30次见面，节奏越来越长越来越快。免费，无需安装。",
  },
  fr: {
    title: "Créature intraduisible — jeu de rythme question-réponse",
    description: "Une créature qui parle en tapant sur son ventre. Répondez en retapant son rythme, en mesure. 30 rencontres, des phrases de plus en plus longues et rapides. Gratuit, sans installation.",
  },
  es: {
    title: "Criatura intraducible — juego de ritmo de pregunta y respuesta",
    description: "Una criatura que habla tamborileando su barriga. Responde repitiendo su ritmo a tiempo. 30 encuentros con frases cada vez más largas y rápidas. Gratis, sin instalar.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image="/assets/sprites/untranslatable-creature/keyart.webp">
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <UntranslatableCreature client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="untranslatable-creature" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

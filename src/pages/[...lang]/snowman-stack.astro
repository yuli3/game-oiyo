---
import UnityMainShell from "../../components/games/UnityMainShell.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SnowmanStack from "../../components/games/SnowmanStack";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";
import gameArtDocument from "../../../config/game-art-v1.json";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "눈사람 쌓기 — 눈덩이를 떨어뜨려 쌓는 무료 겨울 물리 게임",
    description: "움직이는 썰매에서 눈덩이를 떨어뜨려 눈사람을 쌓으세요. 달라붙는 눈, 기울면 넘어지는 무게중심, 바람과 얼음 연못까지 20단계. 설치 없이 브라우저에서 바로.",
  },
  en: {
    title: "Snowman Stack — Free winter physics stacking game",
    description: "Drop snowballs from a swinging sled and build a snowman that stays up. Sticky snow, a centre of mass that tips, wind and a frozen pond across 20 stages, free in your browser.",
  },
  ja: {
    title: "雪だるま積み — 雪玉を落として積む無料の冬の物理ゲーム",
    description: "動くそりから雪玉を落として雪だるまを積もう。くっつく雪、傾くと倒れる重心、風や凍った池まで20ステージ。ブラウザですぐ遊べます。",
  },
  zh: {
    title: "堆雪人 — 放下雪球堆起来的免费冬季物理游戏",
    description: "从摆动的雪橇上放下雪球，堆一个站得稳的雪人。会粘的雪、一歪就倒的重心，还有风和冰湖，共20关，浏览器即玩。",
  },
  fr: {
    title: "Bonhomme en équilibre — Jeu d'empilement physique d'hiver gratuit",
    description: "Lâchez des boules de neige depuis une luge et construisez un bonhomme qui tient debout. Neige collante, centre de gravité, vent et étang gelé sur 20 niveaux, dans le navigateur.",
  },
  es: {
    title: "Torre de muñecos de nieve — Juego gratis de apilar con física invernal",
    description: "Suelta bolas de nieve desde un trineo y construye un muñeco que se mantenga en pie. Nieve pegajosa, centro de gravedad, viento y un estanque helado en 20 niveles, en el navegador.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image={gameArtDocument.games["snowman-stack"]}>
  <div class="mx-auto max-w-7xl px-2 py-2 sm:px-4 sm:py-6">
    <UnityMainShell slug="snowman-stack" build="snowman-stack-unity" locale={locale} name={m.title.split(" — ")[0]} poster="/games/unity-posters/snowman-stack.webp">
      <SnowmanStack client:visible locale={locale} />
    </UnityMainShell>
    <div class="mx-auto mt-8 max-w-3xl px-4">
      <GameGuide slug="snowman-stack" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

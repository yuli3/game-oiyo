---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PatchDungeon from "../../components/games/PatchDungeon";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "패치노트 던전 — 조작이 패치되는 던전 탐험",
    description: "층마다 패치 노트가 방향키를 바꿔 놓는 던전 탐험. 가시·슬라임을 피하고 열쇠로 문을 열어 30층 출구까지. 깊은 층에선 걷는 도중 핫픽스가 터집니다. 무료, 설치 없이 바로.",
  },
  en: {
    title: "Patch Dungeon — the dungeon that patches your controls",
    description: "A grid crawl where every floor's patch notes remap your arrows. Dodge spikes and slimes, grab keys, open doors, and reach the stairs across 30 floors. Deeper floors hotfix mid-run. Free, no install.",
  },
  ja: {
    title: "パッチノートダンジョン — 操作がパッチされるダンジョン",
    description: "階ごとにパッチノートが方向キーを入れ替えるダンジョン探索。トゲとスライムを避け、鍵で扉を開けて30階の出口へ。深い階では歩いている途中にホットフィックスが来ます。無料・インストール不要。",
  },
  zh: {
    title: "补丁说明地牢 — 操作会被打补丁的地牢",
    description: "每层的补丁说明都会调换方向键的地牢探险。躲开尖刺和史莱姆，用钥匙开门，一路走到第30层出口。深层还会在半路热修复。免费，无需安装。",
  },
  fr: {
    title: "Donjon des patchs — le donjon qui patche vos commandes",
    description: "Une exploration en grille où les notes de patch de chaque étage échangent vos flèches. Évitez pics et slimes, prenez les clés, ouvrez les portes et atteignez l'escalier sur 30 étages. Plus bas, des correctifs tombent en pleine marche. Gratuit, sans installation.",
  },
  es: {
    title: "Mazmorra de parches — la mazmorra que parchea tus controles",
    description: "Una exploración en cuadrícula donde las notas del parche de cada piso cambian tus flechas. Esquiva pinchos y slimes, coge llaves, abre puertas y llega a la escalera en 30 pisos. En lo profundo llegan hotfixes a mitad de camino. Gratis, sin instalar.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image="/assets/sprites/patch-dungeon/keyart.webp">
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <PatchDungeon client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="patch-dungeon" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

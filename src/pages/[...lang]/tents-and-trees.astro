---
import BaseLayout from "../../layouts/BaseLayout.astro";
import gameArtDocument from "../../../config/game-art-v1.json";
import TentsAndTreesComp from "../../components/games/TentsAndTrees";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "텐트와 나무 — 매일 새로운 텐트 배치 논리 퍼즐",
    description: "온라인 텐트와 나무 퍼즐을 즐겨보세요. 매일 바뀌는 오늘의 퍼즐(유일해 보장)로 연속 기록을 쌓으며, 모든 나무 옆에 텐트를 하나씩 배치하는 논리 퍼즐입니다.",
  },
  en: {
    title: "Tents and Trees — Free Daily Logic Puzzle",
    description: "Play Tents and Trees online with a new unique-solution daily puzzle and streak tracking. Place one tent adjacent to each tree while following the row and column hints.",
  },
  ja: {
    title: "テントと木 — 毎日新作のテント配置論理パズル",
    description: "オンラインテントと木パズルを楽しもう。毎日変わる今日のパズル（唯一解保証）で連続記録を伸ばし、すべての木の隣にテントを一つずつ配置する論理パズルです。",
  },
  fr: {
    title: "Tentes et Arbres — Puzzle logique quotidien gratuit",
    description: "Jouez aux Tentes et Arbres en ligne avec un puzzle du jour à solution unique et un suivi de série. Placez une tente à côté de chaque arbre en respectant les indices.",
  },
  es: {
    title: "Tiendas y Árboles — Puzle lógico diario gratis",
    description: "Juega a Tiendas y Árboles en línea con un puzle diario de solución única y racha de días. Coloca una tienda junto a cada árbol siguiendo las pistas de filas y columnas.",
  },
  zh: {
    title: "帐篷与树 — 每日更新的帐篷配置逻辑谜题",
    description: "享受线上帐篷与树谜题游戏。每日谜题天天更新（保证唯一解）、累积连续记录，在每棵树旁放置一顶帐篷并遵循行列提示。",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image={gameArtDocument.games["tents-and-trees"]}>
  <div class="mx-auto max-w-2xl px-4 py-8">
    <TentsAndTreesComp client:only="react" locale={locale} />
    <GameGuide slug="tents-and-trees" locale={locale} name={m.title.split(' — ')[0].split(' | ')[0]} />
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OmissionDetective from "../../components/games/OmissionDetective";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "거짓말 탐정 — 빨간 실로 잇는 추리 퍼즐",
    description: "목격자는 거짓말을 안 해요. 다만 몇 곳을 빠뜨릴 뿐. 지도 위 핀을 빨간 실로 이어 용의자의 단 하나뿐인 길을 찾으세요. 30개 사건, 무료, 설치 없이 바로.",
  },
  en: {
    title: "Omission Detective — a red-string deduction puzzle",
    description: "The witnesses never lie, they just leave places out. Run a red string across the map pins to find the suspect's one possible route. 30 cases. Free, no install.",
  },
  ja: {
    title: "省略の探偵 — 赤い糸でつなぐ推理パズル",
    description: "目撃者はうそをつきません。ただ場所を言い忘れるだけ。地図のピンを赤い糸でつなぎ、容疑者のたった一つの道を見つけましょう。30の事件、無料。",
  },
  zh: {
    title: "省略侦探 — 用红线连起来的推理谜题",
    description: "目击者从不说谎，只是漏说了地点。用红线连起地图上的图钉，找出嫌疑人唯一可能的路线。30个案件，免费，无需安装。",
  },
  fr: {
    title: "Détective des oublis — puzzle de déduction au fil rouge",
    description: "Les témoins ne mentent jamais, ils oublient juste des lieux. Tendez un fil rouge entre les punaises du plan pour trouver l'unique trajet du suspect. 30 affaires. Gratuit.",
  },
  es: {
    title: "Detective de omisiones — rompecabezas de hilo rojo",
    description: "Los testigos nunca mienten, solo omiten lugares. Tiende un hilo rojo entre las chinchetas del mapa para hallar la única ruta del sospechoso. 30 casos. Gratis.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image="/assets/sprites/omission-detective/keyart.webp">
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <OmissionDetective client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="omission-detective" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

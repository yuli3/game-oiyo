    tag: { ko: "베를레 훅 물리 & FABRIK 역운동학 촉수 보스전", en: "Verlet Grapple Swing & FABRIK IK Boss Battle", ja: "ベルレ鉤縄スイング＆FABRIK逆運動学触手ボス戦", zh: "韦尔莱摆锤抓钩与FABRIK逆运动学触手Boss战", fr: "Grappin Pendulaire Verlet & Boss Tentacules IK", es: "Gancho de Péndulo Verlet y Jefe con Tentáculos IK" },
    desc: {
      ko: "아레나 천장 앵커에 훅을 걸어 진자 스윙 반동으로 공중 기동을 펼치고, FABRIK 다관절 촉수를 휘두르는 메카니컬 비홀더를 처치하세요.",
      en: "Latch onto ceiling anchors with Verlet pendulum swing physics to dodge attacks and fell the giant Mechanical Beholder's FABRIK tentacles.",
      ja: "天井アンカーにフックをかけ、振り子スイングの慣性で空中を飛び回りながらFABRIK多関節触手を操るビホルダーを撃破しよう。",
      zh: "利用天花板锚点施展韦尔莱摆锤张力荡绳高速机动，在躲避熔岩地刺的同时击溃挥舞FABRIK多关节触手的机械眼魔。",
      fr: "Accrochez-vous aux ancres pour vous balancer et esquiver les tentacules articulés du Beholder Mécanique.",
      es: "Engánchate a los anclajes del techo para balancearte en péndulo y abatir al Beholder Mecánico con tentáculos articulados.",
    },
  },
  {
    slug: "cheese-factory",
    tag: { ko: "SoA Archetype ECS & Boids 자율 AGV 물류 타이쿤", en: "SoA Archetype ECS & Steering Boids AGV Logistics", ja: "SoA Archetype ECS＆Boids自律AGV工場自動化", zh: "SoA Archetype ECS与Boids集群搬运物流大亨", fr: "SoA Archetype ECS & Logistique Boids AGV", es: "SoA Archetype ECS y Logística de Robots Boids" },
    desc: {
      ko: "알프스 목장 우유 저장고부터 살균, 압착, 숙성실 온습도 관리까지! Archetype ECS 대규모 개체 처리와 Boids 군집 AGV 로봇으로 자동화 치즈 제국을 건설하세요.",
      en: "From alpine milk silos to curd pressing and cellar climate curing! Build an automated cheese empire powered by Archetype SoA ECS and Boids transport bots.",
      ja: "アルプスの生乳サイロから低温殺菌、圧搾、熟成庫の温湿度管理まで！ECS大量エンティティとBoids群知能AGVでチーズ帝国を築き上げよう。",
      zh: "从阿尔卑斯原奶筒仓到凝乳压榨与熟成地窖温控！利用高性能 SoA ECS 与 Boids 避障机器人打造现代化全自动奶酪商业帝国。",
      fr: "Du silo de lait au pressage et à l'affinage en cave ! Bâtissez un empire fromager automatisé avec ECS et robots Boids.",
      es: "¡Desde silos de leche alpina hasta el prensado y curado en cava! Construye un imperio quesero con ECS y robots Boids.",
    },
  },
];

const newReleaseGames = NEW_RELEASES_CONFIG
  .map((config) => {
    const game = GAMES.find((g) => g.slug === config.slug);
    return game ? { game, tag: config.tag, desc: config.desc } : null;
  })
  .filter((item): item is { game: Game; tag: Record<Locale, string>; desc: Record<Locale, string> } => Boolean(item));

const STUDIO_FLAGSHIP_CONFIG: Array<{ slug: string; tag: Record<Locale, string> }> = [
  { slug: "neon-survivor", tag: { ko: "무기 진화 액션", en: "Evolution Roguelite", ja: "武器進化アクション", zh: "武器进化肉鸽", fr: "Roguelite d'action", es: "Roguelite de acción" } },
  { slug: "brick-breaker", tag: { ko: "피버 & 파워업", en: "Fever & Powerups", ja: "フィーバー＆強化", zh: "狂热与增强", fr: "Fever & Bonus", es: "Fiebre & Poderes" } },
  { slug: "wordle", tag: { ko: "1:1 라이벌 챌린지", en: "1v1 Rival Battle", ja: "1v1 対戦モード", zh: "1v1 对战挑战", fr: "Duel 1v1", es: "Duelo 1v1" } },
  { slug: "sudoku", tag: { ko: "타임어택 챌린지", en: "Time Attack", ja: "タイムアタック", zh: "竞速挑战", fr: "Course contre la montre", es: "Contrarreloj" } },
  { slug: "water-sort", tag: { ko: "퍼즐 & 시험관 추가", en: "Puzzle & Bonus Tube", ja: "パズル＆追加試験管", zh: "益智与额外试管", fr: "Casse-tête & Tube", es: "Lógica y tubo extra" } },
];

const studioFlagshipGames = STUDIO_FLAGSHIP_CONFIG
  .map((config) => {
    const game = GAMES.find((g) => g.slug === config.slug);
    return game ? { game, tag: config.tag } : null;
  })
  .filter((item): item is { game: Game; tag: Record<Locale, string> } => Boolean(item));

/** Entries without an explicit `kind` are games; only the exceptions are tagged. */
const isGame = (g: Game) => (g.kind ?? "game") === "game";
const gameCount = GAMES.filter(isGame).length;
/** Today's-game pool: real games only, never tools or calculators. */
const todaysGameCandidates = GAMES.filter(isGame).map((g) => ({
  slug: g.slug,
  name: cardName(g),
  emoji: g.emoji,
  cat: g.cat,
  art: cardHasArt(g) ? cardSource(gameArt[g.slug]) : undefined,
}));
/** Tools and calculators are software, not games — say so in the markup too. */
const schemaType = (g: Game) => (isGame(g) ? "Game" : "WebApplication");
const cardJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  hasPart: GAMES.map((g) => ({
    "@type": schemaType(g),
    name: g.name[locale] ?? g.name.en,
    url: new URL(`/${locale}/${g.slug}/`, Astro.site).toString(),
  })),
};
---
<BaseLayout title={m.title} description={m.description}>
  <script type="application/ld+json" set:html={JSON.stringify(cardJsonLd)} />

  <section class="relative overflow-hidden bg-gradient-to-b from-lime-50 via-lime-50/40 to-white px-4 pt-16 pb-10 text-center">
    <div class="relative z-10 mx-auto max-w-2xl">
      <span class="inline-block rounded-full bg-white/70 px-3 py-1 text-xs font-bold text-primary ring-1 ring-lime-100">{h.eyebrow}</span>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-foreground md:text-5xl">{h.title}</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">{h.sub}</p>
      <p class="mt-2 text-xs font-bold text-primary/70">{gameCount} {statLine[locale] ?? statLine.en}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16">
    <nav aria-label={genreNavLabel[locale] ?? genreNavLabel.en} class="-mx-4 mt-6 overflow-x-auto px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <ul class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
        {catOrder.filter((cat) => byCat(cat).length > 0).map((cat) => (
          <li>
            <a href={`#genre-${cat}`} class="inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap rounded-full border border-border bg-card px-4 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:border-primary/50 hover:text-primary">
              <span aria-hidden="true">{catIcon[cat]}</span>
              {catLabel[cat][locale] ?? catLabel[cat].en}
              <span class="text-xs font-bold text-slate-400">{byCat(cat).length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <TodaysGameCard locale={locale} candidates={todaysGameCandidates} />
    <section class="mt-10">
      <div class="mb-4">
        <h2 class="text-xl font-black text-foreground">{newReleaseLabels.sectionTitle}</h2>
        <p class="mt-0.5 text-xs font-medium text-muted-foreground">{newReleaseLabels.subtitle}</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {newReleaseGames.map(({ game: g, tag, desc }) => (
          <a
            href={`/${locale}/${g.slug}/`}
            data-game={g.slug}
            class="group relative flex min-h-56 flex-col justify-between overflow-hidden rounded-2xl border-2 border-primary/30 bg-card p-5 text-left shadow-sm transition-all hover:-translate-y-1 hover:border-primary hover:shadow-lg ring-1 ring-primary/20"
          >
            {cardHasArt(g) ? (
              <Image
                src={cardSource(gameArt[g.slug])}
                alt={cardName(g)}
                width={720}
                widths={[360, 720]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover opacity-35 transition-transform duration-500 group-hover:scale-105 group-hover:opacity-40"
              />
            ) : (
              <span class="absolute right-4 bottom-4 text-7xl opacity-20 transition-transform duration-300 group-hover:scale-110" aria-hidden="true">
                {g.emoji}
              </span>
            )}
            <span class="absolute inset-0 bg-gradient-to-t from-background via-background/70 to-background/30" aria-hidden="true" />
            
            <div class="relative z-10 flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-primary px-2.5 py-0.5 text-xs font-black tracking-wide text-primary-foreground shadow-xs">
                <span>✦</span>
                <span>{newReleaseLabels.badge}</span>
              </span>
              <span class="text-xs font-bold text-muted-foreground">
                {tag[locale] ?? tag.en}
              </span>
            </div>

            <div class="relative z-10 mt-6">
              <div class="flex items-center gap-2">
                <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
                <span class="text-lg font-black tracking-tight text-foreground group-hover:text-primary transition-colors">
                  {cardName(g)}
                </span>
              </div>
              <p class="mt-2 text-xs font-medium leading-relaxed text-muted-foreground line-clamp-2">
                {desc[locale] ?? desc.en}
              </p>
              <div class="mt-3 flex items-center gap-1 text-xs font-bold text-primary group-hover:underline">
                <span>{newReleaseLabels.playNow}</span>
                <span aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
    <section class="mt-10">
      <div class="mb-4">
        <h2 class="text-xl font-black text-foreground">{studioLabels.sectionTitle}</h2>
        <p class="mt-0.5 text-xs font-medium text-muted-foreground">{studioLabels.subtitle}</p>
      </div>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {studioFlagshipGames.map(({ game: g, tag }) => (
          <a
            href={`/${locale}/${g.slug}/`}
            data-game={g.slug}
            class="group relative flex min-h-44 flex-col justify-end overflow-hidden rounded-2xl border-2 border-primary/20 bg-card text-left shadow-sm transition-all hover:-translate-y-1 hover:border-primary hover:shadow-lg ring-1 ring-primary/10"
          >
            {cardHasArt(g) ? (
              <Image
                src={cardSource(gameArt[g.slug])}
                alt={cardName(g)}
                width={640}
                widths={[320, 640]}
                sizes="(min-width: 1024px) 220px, (min-width: 640px) 33vw, 50vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-primary/10 to-muted text-5xl transition-transform duration-300 group-hover:scale-110" aria-hidden="true">
                {g.emoji}
              </span>
            )}
            <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent" aria-hidden="true" />
            <div class="absolute top-2.5 left-2.5 z-10">
              <span class="inline-flex items-center rounded-full bg-primary/90 px-2 py-0.5 text-xs font-black tracking-wide text-primary-foreground backdrop-blur-xs shadow-xs">
                {studioLabels.badge}
              </span>
            </div>
            <div class="relative z-10 p-3.5 text-white">
              <span class="block text-sm font-black drop-shadow-sm leading-tight group-hover:text-primary-foreground">
                {cardName(g)}
              </span>
              <span class="mt-1 inline-block text-xs font-semibold text-white/80 line-clamp-1">
                {tag[locale] ?? tag.en}
              </span>
            </div>
            <span data-winrate hidden class="absolute right-2 top-2 rounded-full bg-background/90 px-2 py-0.5 text-xs font-black text-primary backdrop-blur-xs"></span>
          </a>
        ))}
      </div>
    </section>
    {featuredGames.length > 0 && (
      <section class="mt-10">
        <h2 class="mb-4 text-lg font-black text-foreground">{translations.magazine.featured}</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {featuredGames.map((g) => (
            <a href={`/${locale}/${g.slug}/`} data-game={g.slug} class="group relative flex min-h-36 flex-col justify-end overflow-hidden rounded-2xl border border-slate-100 bg-card text-left shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
              {cardHasArt(g) ? (
                <Image src={cardSource(gameArt[g.slug])} alt={cardName(g)} width={640} widths={[320, 640]} sizes="(min-width: 1024px) 270px, (min-width: 640px) 33vw, 50vw" format="webp" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-lime-50 to-stone-100 text-4xl transition-transform group-hover:scale-110" aria-hidden="true">{g.emoji}</span>
              )}
              <span class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent" aria-hidden="true"></span>
              <span class="relative z-10 p-4 text-sm font-bold text-white drop-shadow-sm" aria-hidden={cardHasArt(g) ? "true" : undefined}>{cardName(g)}</span>
              <span data-winrate hidden class="absolute right-2 top-2 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-black text-primary"></span>
            </a>
          ))}
        </div>
      </section>
    )}
    {catOrder.map((cat) => (
      <section id={`genre-${cat}`} class="mt-10 scroll-mt-20">
        <h2 class="mb-4 flex items-center gap-2 text-lg font-black text-foreground">
          <span aria-hidden="true">{catIcon[cat]}</span>
          {catLabel[cat][locale] ?? catLabel[cat].en}
          <span class="text-xs font-bold text-slate-400">{byCat(cat).length}</span>
        </h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {byCat(cat).map((g) => (
            <a href={`/${locale}/${g.slug}/`} data-game={g.slug} class="group relative flex min-h-36 flex-col justify-end overflow-hidden rounded-2xl border border-slate-100 bg-card text-left shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
              {cardHasArt(g) ? (
                <Image src={cardSource(gameArt[g.slug])} alt={cardName(g)} width={640} widths={[320, 640]} sizes="(min-width: 1024px) 270px, (min-width: 640px) 33vw, 50vw" format="webp" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-lime-50 to-stone-100 text-4xl transition-transform group-hover:scale-110" aria-hidden="true">{g.emoji}</span>
              )}
              <span class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent" aria-hidden="true"></span>
              <span class="relative z-10 p-4 text-sm font-bold text-white drop-shadow-sm" aria-hidden={cardHasArt(g) ? "true" : undefined}>{cardName(g)}</span>
              <span data-winrate hidden class="absolute right-2 top-2 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-black text-primary"></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    // vs-AI 전적이 있는 게임 카드에 승률 배지 표시 (localStorage oiyo:game-records:v1)
    (() => {
      try {
        const rec = JSON.parse(localStorage.getItem("oiyo:game-records:v1") || "{}");
        const winLabel = document.documentElement.lang?.startsWith("ko") ? "승률" : "WR";
        for (const el of document.querySelectorAll("[data-game]")) {
          const r = rec[el.getAttribute("data-game")];
          if (!r) continue;
          const total = (r.w || 0) + (r.l || 0) + (r.d || 0);
          if (total < 3) continue; // 표본 3판 이상일 때만
          const wr = Math.round(((r.w || 0) / total) * 100);
          const badge = el.querySelector("[data-winrate]");
          if (badge) { badge.textContent = `${winLabel} ${wr}%`; badge.hidden = false; }
        }
      } catch { /* storage unavailable — no badges */ }
    })();
  </script>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: { title: "OIYO 아케이드 — 설치 없이 즐기는 무료 게임 43종", description: "체스·스도쿠·워들·2048부터 보드·카드·퍼즐까지. 설치 없이 브라우저에서 바로 즐기는 무료 게임 모음." },
  en: { title: "OIYO Arcade — 43 free browser games, no install", description: "Chess, Sudoku, Wordle, 2048 and more — board, card, and puzzle games you can play instantly in your browser, free." },
  ja: { title: "OIYOアーケード — インストール不要の無料ゲーム43種", description: "チェス・数独・ワードル・2048などボード・カード・パズルまで。インストール不要、ブラウザですぐ遊べる無料ゲーム集。" },
  zh: { title: "OIYO 街机 — 无需安装的43款免费游戏", description: "国际象棋、数独、猜词、2048，以及棋类、纸牌、益智游戏。无需安装，浏览器即玩，全部免费。" },
  fr: { title: "OIYO Arcade — 43 jeux gratuits sans installation", description: "Échecs, Sudoku, Wordle, 2048 et plus — jeux de plateau, de cartes et de réflexion à jouer instantanément, gratuitement." },
  es: { title: "OIYO Arcade — 43 juegos gratis sin instalación", description: "Ajedrez, Sudoku, Wordle, 2048 y más — juegos de mesa, cartas y lógica para jugar al instante, gratis." },
};
const m = meta[locale] ?? meta.en;

const hero: Record<Locale, { eyebrow: string; title: string; sub: string }> = {
  ko: { eyebrow: "🎮 OIYO 아케이드", title: "설치 없이, 바로 즐기는 무료 게임 43종", sub: "보드·카드·퍼즐·아케이드 — 광고 없이 브라우저에서 가볍게." },
  en: { eyebrow: "🎮 OIYO Arcade", title: "43 free games, right in your browser", sub: "Board, card, puzzle and arcade — light, instant, no install." },
  ja: { eyebrow: "🎮 OIYOアーケード", title: "インストール不要、すぐ遊べる無料ゲーム43種", sub: "ボード・カード・パズル・アーケード — ブラウザで手軽に。" },
  zh: { eyebrow: "🎮 OIYO 街机", title: "无需安装，即玩的43款免费游戏", sub: "棋类·纸牌·益智·街机 — 浏览器里轻松开玩。" },
  fr: { eyebrow: "🎮 OIYO Arcade", title: "43 jeux gratuits, directement dans le navigateur", sub: "Plateau, cartes, réflexion et arcade — léger et instantané." },
  es: { eyebrow: "🎮 OIYO Arcade", title: "43 juegos gratis, directo en tu navegador", sub: "Mesa, cartas, lógica y arcade — ligero e instantáneo." },
};
const h = hero[locale] ?? hero.en;

const statLine: Record<Locale, string> = {
  ko: "게임 · 🔒 100% 브라우저에서 실행",
  en: "games · 🔒 100% browser-side",
  ja: "ゲーム · 🔒 100% ブラウザ内で動作",
  zh: "款游戏 · 🔒 100% 浏览器端运行",
  fr: "jeux · 🔒 100 % côté navigateur",
  es: "juegos · 🔒 100 % en el navegador",
};

const catLabel: Record<string, Record<Locale, string>> = {
  board: { ko: "보드게임", en: "Board", ja: "ボード", zh: "棋类", fr: "Plateau", es: "Mesa" },
  card: { ko: "카드게임", en: "Cards", ja: "カード", zh: "纸牌", fr: "Cartes", es: "Cartas" },
  puzzle: { ko: "퍼즐", en: "Puzzle", ja: "パズル", zh: "益智", fr: "Réflexion", es: "Lógica" },
  arcade: { ko: "아케이드", en: "Arcade", ja: "アーケード", zh: "街机", fr: "Arcade", es: "Arcade" },
  luck: { ko: "운·뽑기", en: "Luck", ja: "運だめし", zh: "运气", fr: "Hasard", es: "Suerte" },
  quiz: { ko: "밸런스·퀴즈", en: "Quiz", ja: "クイズ", zh: "问答", fr: "Quiz", es: "Quiz" },
  lostark: { ko: "로스트아크", en: "Lost Ark", ja: "ロストアーク", zh: "失落的方舟", fr: "Lost Ark", es: "Lost Ark" },
};
const catOrder = ["board", "card", "puzzle", "arcade", "luck", "quiz", "lostark"];

/**
 * `kind` keeps the public count honest: a dice roller and a raid-split
 * calculator are useful, but they are not games and must not be counted or
 * marked up as one. See company-brain decision `game-catalog-classification`.
 */
type Kind = "game" | "tool" | "casual" | "calculator";
type Game = { slug: string; emoji: string; cat: string; kind?: Kind; name: Record<Locale, string> };
const GAMES: Game[] = [
  { slug: "chess", emoji: "♟️", cat: "board", name: { ko: "체스", en: "Chess", ja: "チェス", zh: "国际象棋", fr: "Échecs", es: "Ajedrez" } },
  { slug: "checkers", emoji: "🟤", cat: "board", name: { ko: "체커", en: "Checkers", ja: "チェッカー", zh: "西洋跳棋", fr: "Dames", es: "Damas" } },
  { slug: "gomoku", emoji: "⚫", cat: "board", name: { ko: "오목", en: "Gomoku", ja: "五目並べ", zh: "五子棋", fr: "Gomoku", es: "Gomoku" } },
  { slug: "janggi", emoji: "♟️", cat: "board", name: { ko: "장기", en: "Janggi", ja: "チャンギ", zh: "韩国象棋", fr: "Janggi", es: "Janggi" } },
  { slug: "reversi", emoji: "⚪", cat: "board", name: { ko: "리버시", en: "Reversi", ja: "リバーシ", zh: "黑白棋", fr: "Reversi", es: "Reversi" } },
  { slug: "connect-four", emoji: "🔴", cat: "board", name: { ko: "사목", en: "Connect Four", ja: "四目並べ", zh: "四子棋", fr: "Puissance 4", es: "Conecta 4" } },
  { slug: "dominoes", emoji: "🎴", cat: "board", name: { ko: "도미노", en: "Dominoes", ja: "ドミノ", zh: "多米诺", fr: "Dominos", es: "Dominó" } },
  { slug: "kingdomino", emoji: "👑", cat: "board", name: { ko: "킹도미노", en: "Kingdomino", ja: "キングドミノ", zh: "王国骨牌", fr: "Kingdomino", es: "Kingdomino" } },
  { slug: "mahjong", emoji: "🀄", cat: "board", name: { ko: "마작", en: "Mahjong", ja: "麻雀", zh: "麻将", fr: "Mahjong", es: "Mahjong" } },
  { slug: "hitori", emoji: "🔲", cat: "board", name: { ko: "히토리", en: "Hitori", ja: "ひとり", zh: "数织", fr: "Hitori", es: "Hitori" } },
  { slug: "tents-and-trees", emoji: "⛺", cat: "board", name: { ko: "텐트와 나무", en: "Tents & Trees", ja: "テントと木", zh: "帐篷与树", fr: "Tentes & arbres", es: "Tiendas y árboles" } },

  { slug: "blackjack", emoji: "🃏", cat: "card", name: { ko: "블랙잭", en: "Blackjack", ja: "ブラックジャック", zh: "二十一点", fr: "Blackjack", es: "Blackjack" } },
  { slug: "freecell", emoji: "♠️", cat: "card", name: { ko: "프리셀", en: "FreeCell", ja: "フリーセル", zh: "空当接龙", fr: "FreeCell", es: "FreeCell" } },
  { slug: "solitaire", emoji: "♣️", cat: "card", name: { ko: "솔리테어", en: "Solitaire", ja: "ソリティア", zh: "纸牌接龙", fr: "Solitaire", es: "Solitario" } },
  { slug: "hearts-game", emoji: "♥️", cat: "card", name: { ko: "하트", en: "Hearts", ja: "ハート", zh: "红心大战", fr: "Hearts", es: "Corazones" } },

  { slug: "sudoku", emoji: "🔢", cat: "puzzle", name: { ko: "스도쿠", en: "Sudoku", ja: "数独", zh: "数独", fr: "Sudoku", es: "Sudoku" } },
  { slug: "minesweeper", emoji: "💣", cat: "puzzle", name: { ko: "지뢰찾기", en: "Minesweeper", ja: "マインスイーパ", zh: "扫雷", fr: "Démineur", es: "Buscaminas" } },
  { slug: "water-sort", emoji: "🧪", cat: "puzzle", name: { ko: "물 정렬", en: "Water Sort", ja: "水ソート", zh: "水排序", fr: "Tri d'eau", es: "Ordenar agua" } },
  { slug: "light-up", emoji: "💡", cat: "puzzle", name: { ko: "라이트업", en: "Light Up", ja: "美術館", zh: "点灯", fr: "Light Up", es: "Light Up" } },
  { slug: "game-2048", emoji: "🔟", cat: "puzzle", name: { ko: "2048", en: "2048", ja: "2048", zh: "2048", fr: "2048", es: "2048" } },
  { slug: "wordle", emoji: "🟩", cat: "puzzle", name: { ko: "워들", en: "Wordle", ja: "ワードル", zh: "猜词", fr: "Wordle", es: "Wordle" } },
  { slug: "psychology-wordle", emoji: "🧠", cat: "puzzle", name: { ko: "심리 워들", en: "Psychology Wordle", ja: "心理ワードル", zh: "心理猜词", fr: "Wordle psycho", es: "Wordle psico" } },
  { slug: "spatial-memory", emoji: "🧭", cat: "puzzle", name: { ko: "공간 기억", en: "Spatial Memory", ja: "空間記憶", zh: "空间记忆", fr: "Mémoire spatiale", es: "Memoria espacial" } },
  { slug: "korean-semantle", emoji: "🌊", cat: "puzzle", name: { ko: "꼬맨틀", en: "Kkomantle", ja: "꼬맨틀", zh: "韩语猜义", fr: "Kkomantle", es: "Kkomantle" } },
  { slug: "texas-holdem", emoji: "🃏", cat: "card", name: { ko: "텍사스 홀덤", en: "Texas Hold'em", ja: "テキサスホールデム", zh: "德州扑克", fr: "Texas Hold'em", es: "Texas Hold'em" } },

  { slug: "snake-game", emoji: "🐍", cat: "arcade", name: { ko: "스네이크", en: "Snake", ja: "スネーク", zh: "贪吃蛇", fr: "Snake", es: "Snake" } },
  { slug: "aim-trainer", emoji: "🎯", cat: "arcade", name: { ko: "에임 트레이너", en: "Aim Trainer", ja: "エイム練習", zh: "瞄准训练", fr: "Entraîneur de visée", es: "Entrenador de puntería" } },
  { slug: "star-blaster", emoji: "🚀", cat: "arcade", name: { ko: "스타 블래스터", en: "Star Blaster", ja: "スターブラスター", zh: "星际爆破", fr: "Star Blaster", es: "Star Blaster" } },
  { slug: "brick-breaker", emoji: "🧱", cat: "arcade", name: { ko: "벽돌깨기", en: "Brick Breaker", ja: "ブロック崩し", zh: "打砖块", fr: "Casse-briques", es: "Rompeladrillos" } },
  { slug: "cave-dash", emoji: "🛸", cat: "arcade", name: { ko: "케이브 대시", en: "Cave Dash", ja: "ケイブダッシュ", zh: "洞穴冲刺", fr: "Cave Dash", es: "Cave Dash" } },
  { slug: "stack-tower", emoji: "🏙️", cat: "arcade", name: { ko: "스택 타워", en: "Stack Tower", ja: "スタックタワー", zh: "叠塔", fr: "Stack Tower", es: "Stack Tower" } },
  { slug: "rhythm-tap", emoji: "🎵", cat: "arcade", name: { ko: "리듬 탭", en: "Rhythm Tap", ja: "リズムタップ", zh: "节奏点击", fr: "Rhythm Tap", es: "Rhythm Tap" } },
  { slug: "whack-a-mole", emoji: "🔨", cat: "arcade", name: { ko: "두더지 잡기", en: "Whack-a-Mole", ja: "モグラたたき", zh: "打地鼠", fr: "Tape-Taupe", es: "Golpea al Topo" } },
  { slug: "memory-card-game", emoji: "🧩", cat: "arcade", name: { ko: "메모리 카드", en: "Memory Match", ja: "神経衰弱", zh: "记忆翻牌", fr: "Memory", es: "Memoria" } },
  { slug: "number-guessing", emoji: "🔮", cat: "arcade", name: { ko: "숫자 맞히기", en: "Number Guessing", ja: "数当て", zh: "猜数字", fr: "Devine le nombre", es: "Adivina el número" } },

  { slug: "puzzle-15", emoji: "🔢", cat: "puzzle", name: { ko: "15 퍼즐", en: "15 Puzzle", ja: "15パズル", zh: "数字华容道", fr: "Taquin", es: "Puzle 15" } },
  { slug: "kurodoko", emoji: "⬛", cat: "puzzle", name: { ko: "쿠로도코", en: "Kurodoko", ja: "クロドコ", zh: "黑格在哪", fr: "Kurodoko", es: "Kurodoko" } },
  { slug: "maze", emoji: "🌀", cat: "puzzle", name: { ko: "미로 찾기", en: "Maze Escape", ja: "迷路脱出", zh: "走出迷宫", fr: "Labyrinthe", es: "Laberinto" } },
  { slug: "cat-fishing", emoji: "🐟", cat: "arcade", name: { ko: "고양이 낚시", en: "Cat Fishing", ja: "ねこ釣り", zh: "猫咪钓鱼", fr: "Pêche au chat", es: "Pesca gatuna" } },
  { slug: "dot-runner", emoji: "🏃", cat: "arcade", name: { ko: "점프 러너", en: "Dot Runner", ja: "ドットランナー", zh: "点点酷跑", fr: "Dot Runner", es: "Dot Runner" } },
  { slug: "dot-jumpking", emoji: "🦘", cat: "arcade", name: { ko: "점프 킹", en: "Jump King", ja: "ジャンプキング", zh: "跳跳王", fr: "Jump King", es: "Jump King" } },
  { slug: "animal-pop", emoji: "🐵", cat: "arcade", name: { ko: "애니멀 팝", en: "Animal Pop", ja: "アニマルポップ", zh: "动物消消乐", fr: "Animal Pop", es: "Animal Pop" } },
  { slug: "dot-pet", kind: "casual", emoji: "🐣", cat: "arcade", name: { ko: "픽셀 펫", en: "Dot Pet", ja: "ドットペット", zh: "像素宠物", fr: "Dot Pet", es: "Dot Pet" } },
  { slug: "tamagotchi", kind: "casual", emoji: "🥚", cat: "arcade", name: { ko: "다마고치", en: "Tamagotchi", ja: "たまごっち風", zh: "电子宠物", fr: "Tamagotchi", es: "Tamagotchi" } },
  { slug: "yahtzee", emoji: "🎲", cat: "luck", name: { ko: "야찌", en: "Yahtzee", ja: "ヤッツィー", zh: "快艇骰子", fr: "Yahtzee", es: "Yahtzee" } },
  { slug: "dice-roller", kind: "tool", emoji: "🎲", cat: "luck", name: { ko: "주사위", en: "Dice Roller", ja: "サイコロ", zh: "掷骰子", fr: "Dés", es: "Dados" } },
  { slug: "wheel-spinner", kind: "tool", emoji: "🎡", cat: "luck", name: { ko: "룰렛 돌리기", en: "Wheel Spinner", ja: "ルーレット", zh: "转盘", fr: "Roue", es: "Ruleta" } },
  { slug: "lotto-generator", kind: "tool", emoji: "🎰", cat: "luck", name: { ko: "로또 번호 생성", en: "Lotto Generator", ja: "ロト番号生成", zh: "彩票生成", fr: "Générateur loto", es: "Generador lotería" } },
  { slug: "plinko", kind: "tool", emoji: "🔵", cat: "luck", name: { ko: "플린코", en: "Plinko", ja: "プリンコ", zh: "弹珠机", fr: "Plinko", es: "Plinko" } },

  { slug: "balance-game", kind: "casual", emoji: "⚖️", cat: "quiz", name: { ko: "밸런스 게임", en: "Balance Game", ja: "バランスゲーム", zh: "二选一游戏", fr: "Jeu du dilemme", es: "Juego del dilema" } },

  { slug: "lostark-raid-distribution", kind: "calculator", emoji: "⚔️", cat: "lostark", name: { ko: "본1부3 계산기", en: "1-Main/3-Alt Split", ja: "本1副3 分配", zh: "本1副3 分配", fr: "Répartition 1 main/3 alt", es: "Reparto 1 main/3 alt" } },
  { slug: "lostark-auction-calculator", kind: "calculator", emoji: "💰", cat: "lostark", name: { ko: "경매 계산기", en: "Auction Calculator", ja: "オークション計算機", zh: "拍卖计算器", fr: "Calculateur d'enchères", es: "Calculadora de subastas" } },
  { slug: "lostark-bus-calculator", kind: "calculator", emoji: "🚌", cat: "lostark", name: { ko: "버스비 계산기", en: "Bus Fee Calculator", ja: "バス代計算機", zh: "车费计算器", fr: "Calculateur de bus", es: "Calculadora de bus" } },
];

const byCat = (c: string) => GAMES.filter((g) => g.cat === c);

/** Entries without an explicit `kind` are games; only the exceptions are tagged. */
const isGame = (g: Game) => (g.kind ?? "game") === "game";
const gameCount = GAMES.filter(isGame).length;
/** Tools and calculators are software, not games — say so in the markup too. */
const schemaType = (g: Game) => (isGame(g) ? "Game" : "WebApplication");
const cardJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  hasPart: GAMES.map((g) => ({
    "@type": schemaType(g),
    name: g.name[locale] ?? g.name.en,
    url: new URL(`/${locale}/${g.slug}/`, Astro.site).toString(),
  })),
};
---
<BaseLayout title={m.title} description={m.description}>
  <script type="application/ld+json" set:html={JSON.stringify(cardJsonLd)} />

  <section class="relative overflow-hidden bg-gradient-to-b from-lime-50 via-lime-50/40 to-white px-4 pt-16 pb-10 text-center">
    <div class="relative z-10 mx-auto max-w-2xl">
      <span class="inline-block rounded-full bg-white/70 px-3 py-1 text-xs font-bold text-primary ring-1 ring-lime-100">{h.eyebrow}</span>
      <h1 class="mt-4 text-3xl font-black tracking-tight text-foreground md:text-5xl">{h.title}</h1>
      <p class="mt-3 text-base leading-relaxed text-muted-foreground">{h.sub}</p>
      <p class="mt-2 text-xs font-bold text-primary/70">{gameCount} {statLine[locale] ?? statLine.en}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16">
    {catOrder.map((cat) => (
      <section class="mt-10">
        <h2 class="mb-4 flex items-center gap-2 text-lg font-black text-slate-900">
          {catLabel[cat][locale] ?? catLabel[cat].en}
          <span class="text-xs font-bold text-slate-400">{byCat(cat).length}</span>
        </h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {byCat(cat).map((g) => (
            <a href={`/${locale}/${g.slug}/`} data-game={g.slug} class="group relative flex flex-col items-center gap-2 rounded-2xl border border-slate-100 bg-white p-5 text-center shadow-sm transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md">
              <span class="text-4xl transition-transform group-hover:scale-110" aria-hidden="true">{g.emoji}</span>
              <span class="text-sm font-bold text-slate-800 group-hover:text-primary">{g.name[locale] ?? g.name.en}</span>
              <span data-winrate hidden class="absolute right-2 top-2 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-black text-primary"></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    // vs-AI 전적이 있는 게임 카드에 승률 배지 표시 (localStorage oiyo:game-records:v1)
    (() => {
      try {
        const rec = JSON.parse(localStorage.getItem("oiyo:game-records:v1") || "{}");
        const winLabel = document.documentElement.lang?.startsWith("ko") ? "승률" : "WR";
        for (const el of document.querySelectorAll("[data-game]")) {
          const r = rec[el.getAttribute("data-game")];
          if (!r) continue;
          const total = (r.w || 0) + (r.l || 0) + (r.d || 0);
          if (total < 3) continue; // 표본 3판 이상일 때만
          const wr = Math.round(((r.w || 0) / total) * 100);
          const badge = el.querySelector("[data-winrate]");
          if (badge) { badge.textContent = `${winLabel} ${wr}%`; badge.hidden = false; }
        }
      } catch { /* storage unavailable — no badges */ }
    })();
  </script>
</BaseLayout>

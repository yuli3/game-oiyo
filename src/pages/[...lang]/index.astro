  en: { title: "OIYO Arcade — 154 free browser games, no install", description: "Chess, Sudoku, Wordle, and original OIYO games: 154 free games you can play instantly in your browser." },
  ja: { title: "OIYOアーケード — インストール不要の無料ゲーム153種", description: "チェス・数独・ワードルからOIYOオリジナル作品まで、ブラウザですぐ遊べる無料ゲーム153種。" },
  zh: { title: "OIYO 街机 — 无需安装的154款免费游戏", description: "从国际象棋、数独、猜词到 OIYO 原创作品，154款游戏无需安装即可畅玩。" },
  fr: { title: "OIYO Arcade — 154 jeux gratuits sans installation", description: "Échecs, Sudoku, Wordle et créations originales OIYO : 154 jeux gratuits dans le navigateur." },

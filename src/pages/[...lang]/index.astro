---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TodaysGameCard from "../../components/TodaysGameCard.astro";
import { getTranslations, locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import gameArtDocument from "../../../config/game-art-v1.json";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
const cardSources = import.meta.glob<ImageMetadata>(["../../../public/games/*.png", "../../../public/games/*-keyart.webp", "../../../public/prototypes/*.webp", "../../../public/assets/sprites/**/keyart.webp"], { eager: true, import: "default" });
const cardSource = (url: string) => cardSources[`../../../public${url}`];

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: Locale };
const translations = await getTranslations(locale);

const meta: Record<Locale, { title: string; description: string }> = {

      zh: "16x10战术网格、4大经典防御塔、3段升级、15波暗影巨龙领主",
      fr: "Grille 16x10, 4 tours, 3 niveaux d'amélioration, boss dragon vague 15",
      es: "Cuadrícula 16x10, 4 torres, 3 niveles de mejora, dragón jefe oleada 15",
    },
  },
  {
    slug: "charge-climb",
    tag: { ko: "정밀 물리 차지 점프", en: "Precision charge jump", ja: "精密物理ジャンプ", zh: "高精度物理蓄力跳跃", fr: "Saut de Précision", es: "Salto de Precisión" },
    desc: {
      ko: "차징 물리 점프, 발판 충돌, 낙하 카메라 트라우마 쉐이크, 칩튠 사운드",
      en: "Charge jump physics, platform bounce, drop trauma shake, chiptune sfx",
      ja: "チャージ物理ジャンプ、足場バウンド、落下カメラトラウマ、チップチューン音",
      zh: "蓄力物理跳跃、跳台边缘反弹碰撞、坠落屏幕震动冲击、正统芯片音效",
      fr: "Physique de saut chargé, rebond de plateforme, secousse de chute",
      es: "Física de salto cargado, rebote en plataformas, cámara sacudida",
    },
  },
  {
    slug: "dot-runner",
    tag: { ko: "PB 고스트 레이스 러너", en: "PB Ghost Race Runner", ja: "PBゴーストレース", zh: "个人最佳鬼影竞速跑酷", fr: "Course Fantôme PB", es: "Carrera Fantasma Récord" },
    desc: {
      ko: "실시간 개인 최고기록(PB) 고스트 듀얼, 장애물 슬라이드, 3축 가속 쉐이크",
      en: "Real-time personal best ghost racing, obstacle slides, 3-axis trauma",
      ja: "リアルタイムPBゴースト対決、障害物スライディング、3軸カメラ振動",
      zh: "实时个人最佳(PB)双重鬼影同屏对决、障碍滑铲越位、3轴加速度震颤",
      fr: "Course contre son fantôme personnel en temps réel, glissades",
      es: "Carrera contra tu fantasma récord en tiempo real, deslizamientos",
    },
  },
  {
    slug: "dot-pet",
    tag: { ko: "픽셀 가상 펫 육성", en: "Pixel Virtual Pet Sim", ja: "ピクセル仮想ペット育成", zh: "像素虚拟宠物养成", fr: "Animal Virtuel Pixel", es: "Mascota Virtual Pixel" },
    desc: {
      ko: "다마고치 스타일 2D 캔버스, 먹이주기·놀아주기·청소, 4단계 진화 트리",
      en: "Tamagotchi-style 2D canvas, feeding, playing, cleaning, 4-stage evolution",
      ja: "たまごっち風2Dキャンバス、食事・遊び・清掃、4段階の進化ツリー",
      zh: "拓麻歌子风2D画板、喂食互动清洁、4阶全分支成长进化树",
      fr: "Style Tamagotchi sur toile 2D, nourrir, jouer, nettoyer, 4 stades",
      es: "Estilo Tamagotchi en lienzo 2D, alimentar, jugar, limpiar, 4 fases",
    },
  },
];

const dotArcadeGames = DOT_ARCADE_CONFIG
  .map((config) => {
    const game = GAMES.find((g) => g.slug === config.slug);
    return game ? { game, tag: config.tag, desc: config.desc } : null;
  })
  .filter((item): item is { game: Game; tag: Record<Locale, string>; desc: Record<Locale, string> } => Boolean(item));


/** 2026-11-24 hub pass: helpers shared by the shelves and the all-games grid. */
const artOf = (g: Game) => (cardHasArt(g) ? cardSource(gameArt[g.slug]) : undefined);
const pageSources = import.meta.glob<string>("./*.astro", { query: "?raw", import: "default", eager: true });
const unitySlugs = new Set(
  Object.entries(pageSources)
    .filter(([, src]) => src.includes("UnityMainShell"))
    .map(([path]) => path.slice(2, -".astro".length)),
);
const newBadgeSlugs = new Set(NEW_RELEASES_CONFIG.slice(0, 12).map((c) => c.slug));
const hubUi: Record<Locale, { search: string; placeholder: string; continueTitle: string; allGames: string; all: string; more: string; count: string; allCount: string; noResults: string; newBadge: string; d3: string }> = {
  ko: { search: "게임 검색", placeholder: "게임 이름으로 찾기 (예: 체스, 스네이크)", continueTitle: "▶ 이어서 하기", allGames: "모든 게임", all: "전체", more: "더 보기 (+{n})", count: "{n}개 게임", allCount: "전체 {n}개", noResults: "찾는 게임이 없어요. 다른 이름으로 검색해 보세요.", newBadge: "NEW", d3: "3D" },
  en: { search: "Search games", placeholder: "Find a game (e.g. chess, snake)", continueTitle: "▶ Continue playing", allGames: "All games", all: "All", more: "Show more (+{n})", count: "{n} games", allCount: "{n} in total", noResults: "No game matches. Try another name.", newBadge: "NEW", d3: "3D" },
  ja: { search: "ゲーム検索", placeholder: "ゲーム名で探す（例：チェス、スネーク）", continueTitle: "▶ 続きから遊ぶ", allGames: "すべてのゲーム", all: "すべて", more: "もっと見る（+{n}）", count: "{n}件", allCount: "全{n}件", noResults: "該当するゲームがありません。別の名前で検索してください。", newBadge: "NEW", d3: "3D" },
  zh: { search: "搜索游戏", placeholder: "按名称查找游戏（如：国际象棋、贪吃蛇）", continueTitle: "▶ 继续游玩", allGames: "全部游戏", all: "全部", more: "显示更多（+{n}）", count: "{n} 款游戏", allCount: "共 {n} 款", noResults: "没有找到游戏，请换个名称试试。", newBadge: "NEW", d3: "3D" },
  fr: { search: "Rechercher un jeu", placeholder: "Trouver un jeu (ex. échecs, snake)", continueTitle: "▶ Reprendre", allGames: "Tous les jeux", all: "Tous", more: "Voir plus (+{n})", count: "{n} jeux", allCount: "{n} au total", noResults: "Aucun jeu trouvé. Essayez un autre nom.", newBadge: "NEW", d3: "3D" },
  es: { search: "Buscar juegos", placeholder: "Busca un juego (p. ej. ajedrez, snake)", continueTitle: "▶ Seguir jugando", allGames: "Todos los juegos", all: "Todos", more: "Ver más (+{n})", count: "{n} juegos", allCount: "{n} en total", noResults: "Ningún juego coincide. Prueba otro nombre.", newBadge: "NEW", d3: "3D" },
};
const u = hubUi[locale] ?? hubUi.en;
const badge3dOf = (g: Game) => (unitySlugs.has(g.slug) ? u.d3 : undefined);
const searchText = (g: Game) =>
  [g.slug.replace(/-/g, " "), ...Object.values(g.name), catLabel[g.cat]?.[locale] ?? ""].join(" ").toLowerCase();

/** Entries without an explicit `kind` are games; only the exceptions are tagged. */
const isGame = (g: Game) => (g.kind ?? "game") === "game";
const gameCount = GAMES.filter(isGame).length;
/** Today's-game pool: real games only, never tools or calculators. */
const todaysGameCandidates = GAMES.filter(isGame).map((g) => ({
  slug: g.slug,
  name: cardName(g),
  emoji: g.emoji,
  cat: g.cat,
  art: cardHasArt(g) ? cardSource(gameArt[g.slug]) : undefined,
}));
/** Tools and calculators are software, not games — say so in the markup too. */
const schemaType = (g: Game) => (isGame(g) ? "Game" : "WebApplication");
const cardJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: m.title,
  description: m.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  hasPart: GAMES.map((g) => ({
    "@type": schemaType(g),
    name: g.name[locale] ?? g.name.en,
    url: new URL(`/${locale}/${g.slug}/`, Astro.site).toString(),
  })),
};
---
<BaseLayout title={m.title} description={m.description}>
  <script type="application/ld+json" set:html={JSON.stringify(cardJsonLd)} />

  <section class="border-b-2 border-foreground bg-accent pt-5 pb-6 sm:pt-10 sm:pb-8">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-xs font-black text-primary">{h.eyebrow}</p>
      <h1 class="mt-1 text-2xl font-black tracking-tight text-foreground sm:text-4xl">{h.title}</h1>
      <p class="mt-1 hidden text-sm text-foreground sm:block">{h.sub}</p>
      <form role="search" action={`/${locale}/#all-games`} data-game-search-form class="mt-4 max-w-xl">
        <label for="game-search" class="sr-only">{u.search}</label>
        <span class="game-card flex h-12 items-center gap-2 px-3">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="game-search" name="q" type="search" enterkeyhint="search" autocomplete="off" placeholder={u.placeholder} class="h-full min-w-0 flex-1 bg-transparent text-base font-bold text-foreground outline-none placeholder:font-semibold placeholder:text-muted-foreground" />
        </span>
      </form>
      <p class="mt-3 text-xs font-bold text-primary">{gameCount} {statLine[locale] ?? statLine.en}</p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16">
    <nav aria-label={genreNavLabel[locale] ?? genreNavLabel.en} data-shelf class="-mx-4 mt-4 overflow-x-auto px-4 pb-1 no-scrollbar">
      <ul class="flex w-max gap-2 py-1 sm:w-auto sm:flex-wrap">
        {catOrder.filter((cat) => byCat(cat).length > 0).map((cat) => (
          <li>
            <a href={`#genre-${cat}`} data-genre-link={cat} class="game-chip inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap px-4 text-sm font-bold">
              <span aria-hidden="true">{catIcon[cat]}</span>
              {catLabel[cat][locale] ?? catLabel[cat].en}
              <span class="text-xs font-bold text-muted-foreground">{byCat(cat).length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <section data-continue data-shelf hidden class="mt-6" aria-labelledby="continue-title">
      <h2 id="continue-title" class="mb-3 text-lg font-black text-foreground">{u.continueTitle}</h2>
      <div data-continue-row class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 pt-1 pb-3"></div>
    </section>

    <div data-shelf>
      <TodaysGameCard locale={locale} candidates={todaysGameCandidates} />
    </div>

    <section data-shelf class="mt-10">
      <div class="mb-3">
        <h2 class="text-xl font-black text-foreground">{newReleaseLabels.sectionTitle}</h2>
        <p class="mt-0.5 text-xs font-medium text-muted-foreground">{newReleaseLabels.subtitle}</p>
      </div>
      <div class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 pt-1 pb-3 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4">
        {newReleaseGames.map(({ game: g, tag, desc }) => (
          <GameTile variant="shelf" href={`/${locale}/${g.slug}/`} slug={g.slug} name={cardName(g)} emoji={g.emoji} art={artOf(g)} tag={tag[locale] ?? tag.en} desc={desc[locale] ?? desc.en} badge={newReleaseLabels.badge} badge3d={badge3dOf(g)} />
        ))}
      </div>
    </section>

    <section id="dot-arcade" data-shelf class="mt-10 scroll-mt-20">
      <div class="mb-3">
        <h2 class="flex flex-wrap items-center gap-2 text-xl font-black text-foreground">
          {dotLabels.sectionTitle}
          <span class="rounded-sm border-2 border-foreground bg-card px-1.5 text-xs font-black text-primary">{dotLabels.badge}</span>
        </h2>
        <p class="mt-0.5 text-xs font-medium text-muted-foreground">{dotLabels.subtitle}</p>
      </div>
      <div class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 pt-1 pb-3 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4">
        {dotArcadeGames.map(({ game: g, tag, desc }) => (
          <GameTile variant="shelf" href={`/${locale}/${g.slug}/`} slug={g.slug} name={cardName(g)} emoji={g.emoji} art={artOf(g)} tag={tag[locale] ?? tag.en} desc={desc[locale] ?? desc.en} badge3d={badge3dOf(g)} />
        ))}
      </div>
    </section>

    <section data-shelf class="mt-10">
      <div class="mb-3">
        <h2 class="text-xl font-black text-foreground">{studioLabels.sectionTitle}</h2>
        <p class="mt-0.5 text-xs font-medium text-muted-foreground">{studioLabels.subtitle}</p>
      </div>
      <div class="-mx-4 flex snap-x gap-3 overflow-x-auto px-4 pt-1 pb-3 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-5">
        {[...studioFlagshipGames.map(({ game: g, tag }) => ({ g, tag: tag[locale] ?? tag.en })), ...featuredGames.map((g) => ({ g, tag: catLabel[g.cat][locale] ?? catLabel[g.cat].en }))].map(({ g, tag }) => (
          <GameTile variant="shelf" href={`/${locale}/${g.slug}/`} slug={g.slug} name={cardName(g)} emoji={g.emoji} art={artOf(g)} tag={tag} badge3d={badge3dOf(g)} />
        ))}
      </div>
    </section>

    <section id="all-games" class="mt-12 scroll-mt-20" aria-labelledby="all-games-title">
      <h2 id="all-games-title" class="text-xl font-black text-foreground">{u.allGames}</h2>
      <div class="sticky top-16 z-20 -mx-4 mt-2 border-b-2 border-foreground bg-background px-4 py-2">
        <div class="overflow-x-auto no-scrollbar">
          <div class="flex w-max gap-2 py-0.5" role="group" aria-label={genreNavLabel[locale] ?? genreNavLabel.en}>
            <button type="button" data-filter="all" aria-pressed="true" class="game-chip inline-flex min-h-11 items-center whitespace-nowrap px-4 text-sm font-bold">{u.all}</button>
            {catOrder.filter((cat) => byCat(cat).length > 0).map((cat) => (
              <button type="button" data-filter={cat} aria-pressed="false" class="game-chip inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap px-4 text-sm font-bold">
                <span aria-hidden="true">{catIcon[cat]}</span>
                {catLabel[cat][locale] ?? catLabel[cat].en}
              </button>
            ))}
          </div>
        </div>
        <p data-result-count aria-live="polite" class="mt-1 min-h-4 text-xs font-bold text-muted-foreground"></p>
      </div>
      <p data-no-results hidden class="mt-6 rounded-lg border-2 border-dashed border-border p-6 text-center text-sm font-bold text-muted-foreground">{u.noResults}</p>
      {catOrder.filter((cat) => byCat(cat).length > 0).map((cat) => (
        <section id={`genre-${cat}`} data-genre={cat} class="mt-6 scroll-mt-40">
          <h3 class="mb-3 flex items-center gap-2 text-lg font-black text-foreground">
            <span aria-hidden="true">{catIcon[cat]}</span>
            {catLabel[cat][locale] ?? catLabel[cat].en}
            <span class="text-xs font-bold text-muted-foreground">{byCat(cat).length}</span>
          </h3>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {byCat(cat).map((g) => (
              <GameTile href={`/${locale}/${g.slug}/`} slug={g.slug} cat={cat} search={searchText(g)} name={cardName(g)} emoji={g.emoji} art={artOf(g)} badge={newBadgeSlugs.has(g.slug) ? u.newBadge : undefined} badge3d={badge3dOf(g)} />
            ))}
          </div>
          <button type="button" data-more hidden class="game-btn mt-4 flex min-h-11 w-full items-center justify-center text-sm">{u.more}</button>
        </section>
      ))}
    </section>
  </div>

  <script is:inline define:vars={{ moreLabel: u.more, countLabel: u.count, allCountLabel: u.allCount }}>
    (() => {
      const PAGE = 8;
      const root = document.getElementById("all-games");
      if (!root) return;
      const sections = [...root.querySelectorAll("[data-genre]")];
      const chips = [...root.querySelectorAll("[data-filter]")];
      const input = document.getElementById("game-search");
      const count = root.querySelector("[data-result-count]");
      const empty = root.querySelector("[data-no-results]");
      const shelves = [...document.querySelectorAll("[data-shelf]")];
      const expanded = new Set();
      let filter = "all";
      let query = "";
      const norm = (s) => s.toLowerCase().normalize("NFKC").replace(/\s+/g, "");

      function apply() {
        const q = norm(query);
        let shown = 0;
        for (const sec of sections) {
          const cat = sec.dataset.genre;
          const tiles = [...sec.querySelectorAll("[data-tile]")];
          const more = sec.querySelector("[data-more]");
          let visible = 0;
          if (q) {
            for (const t of tiles) { const hit = norm(t.dataset.search || "").includes(q); t.hidden = !hit; if (hit) visible++; }
            more.hidden = true;
          } else {
            const open = filter !== "all" || expanded.has(cat);
            tiles.forEach((t, i) => { t.hidden = !open && i >= PAGE; });
            visible = tiles.length;
            const rest = tiles.length - PAGE;
            more.hidden = open || rest <= 0;
            if (!more.hidden) more.textContent = moreLabel.replace("{n}", String(rest));
          }
          const sectionOn = (filter === "all" || filter === cat) && visible > 0;
          sec.hidden = !sectionOn;
          if (sectionOn) shown += visible;
        }
        for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.filter === filter));
        for (const s of shelves) {
          if (s.hasAttribute("data-continue")) s.hidden = Boolean(q) || !s.dataset.ready;
          else s.hidden = Boolean(q);
        }
        empty.hidden = shown > 0;
        count.textContent = q || filter !== "all" ? countLabel.replace("{n}", String(shown)) : allCountLabel.replace("{n}", String(shown));
      }

      for (const c of chips) c.addEventListener("click", () => { filter = c.dataset.filter; apply(); root.scrollIntoView({ block: "start" }); });
      for (const sec of sections) sec.querySelector("[data-more]").addEventListener("click", () => { expanded.add(sec.dataset.genre); apply(); });
      for (const a of document.querySelectorAll("[data-genre-link]")) {
        a.addEventListener("click", (e) => { e.preventDefault(); filter = a.dataset.genreLink; apply(); history.replaceState(null, "", `#genre-${filter}`); root.scrollIntoView({ block: "start" }); });
      }
      if (input) {
        input.addEventListener("input", () => { query = input.value.trim(); apply(); });
        input.form?.addEventListener("submit", (e) => { e.preventDefault(); input.blur(); root.scrollIntoView({ block: "start" }); });
        const params = new URLSearchParams(location.search);
        if (params.get("q")) { input.value = params.get("q"); query = input.value.trim(); }
      }
      const fromHash = /^#genre-([a-z]+)$/.exec(location.hash);
      if (fromHash && sections.some((s) => s.dataset.genre === fromHash[1])) filter = fromHash[1];

      // "Continue" row: pages opened recently (slug store) + legacy last-played stamps.
      try {
        const stamps = {};
        const add = (obj) => { for (const [k, v] of Object.entries(obj || {})) { const t = Date.parse(v); if (!Number.isNaN(t) && (!stamps[k] || stamps[k] < t)) stamps[k] = t; } };
        add(JSON.parse(localStorage.getItem("oiyo:game-recent-opened:v1") || "{}"));
        add(JSON.parse(localStorage.getItem("oiyo:game-last-played:v1") || "{}"));
        const row = document.querySelector("[data-continue-row]");
        const box = document.querySelector("[data-continue]");
        const picks = Object.entries(stamps).sort((a, b) => b[1] - a[1]).map(([slug]) => root.querySelector(`[data-tile][data-game="${CSS.escape(slug)}"]`)).filter(Boolean).slice(0, 10);
        if (row && box && picks.length) {
          for (const tile of picks) {
            const clone = tile.cloneNode(true);
            clone.removeAttribute("data-tile"); clone.removeAttribute("data-search"); clone.removeAttribute("data-cat"); clone.hidden = false;
            clone.classList.add("w-40", "shrink-0", "snap-start");
            row.append(clone);
          }
          box.dataset.ready = "1";
        }
      } catch { /* storage unavailable — no continue row */ }

      apply();
      if (fromHash || query) root.scrollIntoView({ block: "start" });
    })();
  </script>

  <script is:inline>
    // vs-AI 전적이 있는 게임 카드에 승률 배지 표시 (localStorage oiyo:game-records:v1)
    (() => {
      try {
        const rec = JSON.parse(localStorage.getItem("oiyo:game-records:v1") || "{}");
        const winLabel = document.documentElement.lang?.startsWith("ko") ? "승률" : "WR";
        for (const el of document.querySelectorAll("[data-game]")) {
          const r = rec[el.getAttribute("data-game")];
          if (!r) continue;
          const total = (r.w || 0) + (r.l || 0) + (r.d || 0);
          if (total < 3) continue; // 표본 3판 이상일 때만
          const wr = Math.round(((r.w || 0) / total) * 100);
          const badge = el.querySelector("[data-winrate]");
          if (badge) { badge.textContent = `${winLabel} ${wr}%`; badge.hidden = false; }
        }
      } catch { /* storage unavailable — no badges */ }
    })();
  </script>
</BaseLayout>

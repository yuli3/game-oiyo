  ko: { eyebrow: "🎮 OIYO 아케이드", title: "설치 없이, 바로 즐기는 무료 게임 154종", sub: "보드·카드·퍼즐·오리지널 아케이드 — 브라우저에서 바로 시작하세요." },
  en: { eyebrow: "🎮 OIYO Arcade", title: "154 free games, right in your browser", sub: "Board, card, puzzle, and original arcade games — instant and free." },

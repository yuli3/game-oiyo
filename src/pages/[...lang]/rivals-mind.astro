---
import BaseLayout from "../../layouts/BaseLayout.astro";import RivalsMind from "../../components/games/RivalsMind";import GameGuide from "../../components/GameGuide.astro";import {locales} from "../../lib/i18n";import type {Locale} from "../../lib/i18n";
export async function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}));}const {locale}=Astro.props as {locale:Locale};
const meta:Record<Locale,{title:string;description:string;name:string}>={ko:{title:"라이벌의 마음 — 습관을 학습하는 결투 AI",description:"공격과 회피 습관을 로컬에서 학습하고 판단 근거를 공개하는 설명 가능한 5라운드 결투 게임.",name:"라이벌의 마음"},en:{title:"The Rival's Mind — A Duel AI That Learns You",description:"A five-round duel against a local adaptive rival that learns your habits and discloses every reason.",name:"The Rival's Mind"},ja:{title:"ライバルの心 — 癖を学ぶ決闘AI",description:"攻撃と回避の癖を端末内で学び、判断理由を公開する5ラウンド決闘ゲーム。",name:"ライバルの心"},zh:{title:"对手的心 — 学习你习惯的决斗AI",description:"在本地学习攻击与闪避习惯，并公开每次判断理由的五回合决斗游戏。",name:"对手的心"},fr:{title:"Dans la tête du rival — duel adaptatif expliqué",description:"Un duel en cinq manches contre un rival local qui apprend vos habitudes et explique chaque adaptation.",name:"Dans la tête du rival"},es:{title:"La mente del rival — duelo adaptativo explicado",description:"Duelo de cinco rondas contra un rival local que aprende tus hábitos y explica cada adaptación.",name:"La mente del rival"}};const m=meta[locale]??meta.en;
---
<BaseLayout title={m.title} description={m.description} heading={m.title}><div class="mx-auto max-w-3xl px-4 py-8"><RivalsMind client:load locale={locale}/><GameGuide slug="rivals-mind" locale={locale} name={m.name}/></div></BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MonsterInterview from "../../components/games/MonsterInterview";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "몬스터 면접관 — 도장 찍는 인사팀 아케이드",
    description: "괴물 회사 인사팀 책상에서 이력서를 보고 채용·거절 도장을 끌어 찍으세요. 30일 동안 조건이 늘고 위조 이력서가 섞입니다. 무료, 설치 없이 바로 플레이.",
  },
  en: {
    title: "Monster Interview — stamp-the-resume HR arcade",
    description: "Sit at a monster company's HR desk, check each resume against today's rules, and drag the HIRE or REJECT stamp. 30 days, stacking rules, forged resumes. Free, no install.",
  },
  ja: {
    title: "モンスター面接官 — はんこを押す人事アーケード",
    description: "モンスター会社の人事の机で、履歴書を見て採用・不採用のはんこを押しましょう。30日間で条件が増え、偽造履歴書も混ざります。無料・インストール不要。",
  },
  zh: {
    title: "怪物面试官 — 盖章人事街机",
    description: "坐在怪物公司人事部的桌前，对照简历和今日条件，拖动录用或拒绝印章。30天条件越来越多，还会混进伪造简历。免费，无需安装。",
  },
  fr: {
    title: "Entretien avec un monstre — arcade RH à tampons",
    description: "Au bureau RH d'une entreprise de monstres, comparez chaque CV aux critères du jour et tamponnez EMBAUCHER ou REFUSER. 30 jours, critères empilés, faux CV. Gratuit, sans installation.",
  },
  es: {
    title: "Entrevista con un monstruo — arcade de RR. HH. con sellos",
    description: "En el escritorio de RR. HH. de una empresa de monstruos, compara cada currículum con los requisitos del día y sella CONTRATAR o RECHAZAR. 30 días, requisitos que se acumulan y currículums falsos. Gratis, sin instalar.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image="/assets/sprites/monster-interview/keyart.webp">
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <MonsterInterview client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="monster-interview" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>

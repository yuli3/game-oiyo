---
import BaseLayout from"../../layouts/BaseLayout.astro";import ShadowArchitect from"../../components/games/ShadowArchitect";import GameGuide from"../../components/GameGuide.astro";import{locales}from"../../lib/i18n";import type{Locale}from"../../lib/i18n";export async function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}));}const{locale}=Astro.props as{locale:Locale};const meta:Record<Locale,{title:string;description:string;name:string}>={ko:{title:"그림자 건축가 — 3D 구조로 2D 실루엣 만들기",description:"다섯 입체 블록을 회전·이동·적층해 벽의 목표 그림자를 완성하는 3D 공간 퍼즐.",name:"그림자 건축가"},en:{title:"Shadow Architect — Build a 3D Silhouette",description:"Rotate, move and stack five spatial blocks to complete a target shadow on the wall.",name:"Shadow Architect"},ja:{title:"影の建築家 — 3D構造で2Dシルエットを作る",description:"5つの立体ブロックを回転・移動・積層し、壁の目標影を完成させる3D空間パズル。",name:"影の建築家"},zh:{title:"影子建筑师 — 用3D结构完成2D剪影",description:"旋转、移动并堆叠五个立体方块，完成墙上的目标影子。",name:"影子建筑师"},fr:{title:"Architecte des ombres — bâtir une silhouette 3D",description:"Tournez, déplacez et empilez cinq blocs pour reproduire l'ombre cible sur un mur.",name:"Architecte des ombres"},es:{title:"Arquitecto de sombras — construye una silueta 3D",description:"Gira, mueve y apila cinco bloques espaciales para completar la sombra objetivo.",name:"Arquitecto de sombras"}};const m=meta[locale]??meta.en;
---
<BaseLayout title={m.title} description={m.description} heading={m.title}><div class="mx-auto max-w-3xl px-4 py-8"><ShadowArchitect client:load locale={locale}/><GameGuide slug="shadow-architect" locale={locale} name={m.name}/></div></BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";import GravityGarden from "../../components/games/GravityGarden";import GameGuide from "../../components/GameGuide.astro";import {locales} from "../../lib/i18n";import type {Locale} from "../../lib/i18n";export async function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}));}const {locale}=Astro.props as {locale:Locale};const meta:Record<Locale,{title:string;description:string;name:string}>={ko:{title:"중력 정원 — 씨앗으로 물리를 바꾸는 생태 퍼즐",description:"중력꽃·이끼·바람갈대를 심어 물방울을 웅덩이로 이끄는 결정론적 물리 생태 게임.",name:"중력 정원"},en:{title:"Gravity Garden — Plant a Field, Guide the Water",description:"Plant gravity blooms, moss and wind reeds to guide five droplets through a deterministic physics garden.",name:"Gravity Garden"},ja:{title:"重力の庭 — 種で物理を変える生態パズル",description:"重力花・苔・風の葦を植え、水滴を池へ導く決定論的な物理生態ゲーム。",name:"重力の庭"},zh:{title:"重力花园 — 用种子改变物理",description:"种下重力花、苔藓和风芦，把五滴水引向水池的确定性物理生态游戏。",name:"重力花园"},fr:{title:"Jardin gravitationnel — semez les lois physiques",description:"Plantez fleurs-gravité, mousse et roseaux du vent pour guider cinq gouttes dans un jardin physique déterministe.",name:"Jardin gravitationnel"},es:{title:"Jardín gravitatorio — siembra las leyes físicas",description:"Planta flores gravitatorias, musgo y juncos de viento para guiar cinco gotas en un jardín físico determinista.",name:"Jardín gravitatorio"}};const m=meta[locale]??meta.en;
---
<BaseLayout title={m.title} description={m.description} heading={m.title}><div class="mx-auto max-w-3xl px-4 py-8"><GravityGarden client:load locale={locale}/><GameGuide slug="gravity-garden" locale={locale} name={m.name}/></div></BaseLayout>

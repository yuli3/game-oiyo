---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MiniMetro from "../../components/games/MiniMetro";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "미니 메트로 웹 — 미니멀 절차적 지하철 노선망 설계 시뮬레이터",
    description: "팽창하는 도시의 역들을 효율적인 지하철 노선으로 연결하여 승객을 목적지까지 운송하는 미니멀 전략 시뮬레이션 게임.",
  },
  en: {
    title: "Mini Metro Web — Minimalist Procedural Subway Line Simulator",
    description: "Design efficient subway networks across an expanding city. Connect stations and manage trains to prevent overcrowding.",
  },
  ja: {
    title: "ミニメトロ ウェブ — ミニマル地下鉄路線網設計シミュレーター",
    description: "急成長する都市の駅同士を地下鉄路線で結び、乗客をスムーズに目的地へ運ぶミニマル交通設計シミュレーション。",
  },
  zh: {
    title: "迷你地铁 网页版 — 极简程序化地铁网络规划模拟器",
    description: "在不断扩张的城市中规划高效的地铁线路，连接车站并调度列车，避免车站因拥挤而瘫痪。",
  },
  fr: {
    title: "Mini Metro Web — Simulateur minimaliste de réseau de métro",
    description: "Dessinez les lignes de métro d'une ville en pleine croissance. Reliez les stations et gérez les rames pour éviter la saturation.",
  },
  es: {
    title: "Mini Metro Web — Simulador minimalista de líneas de metro",
    description: "Diseña redes de metro eficientes en una ciudad en expansión. Conecta estaciones y gestiona trenes para evitar aglomeraciones.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <MiniMetro client:load locale={locale} />
    <GameGuide slug="mini-metro" locale={locale} name={m.title.split(" — ")[0]} />
  </div>
</BaseLayout>

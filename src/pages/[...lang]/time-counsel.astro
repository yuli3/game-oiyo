---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TimeCounsel from "../../components/games/TimeCounsel";
import { locales } from "../../lib/i18n";
import type { Locale } from "../../lib/i18n";
import GameGuide from "../../components/GameGuide.astro";

export async function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };

const meta: Record<Locale, { title: string; description: string }> = {
  ko: {
    title: "변호사 vs 시간 — 증언 속 거짓을 잡는 실시간 반박 게임",
    description: "증거판과 어긋난 증언 한 칸을 시간 안에 톡! 맞는 말은 흘려보내고 거짓만 반박하세요. 30번의 재판, 점점 빨라지는 증인. 무료, 설치 없이 바로.",
  },
  en: {
    title: "Counsel Against Time — a real-time spot-the-lie courtroom game",
    description: "Tap the one chip in each statement that contradicts the evidence before the fuse burns out. Let true statements pass. 30 trials, faster witnesses. Free, no install.",
  },
  ja: {
    title: "弁護士対時間 — 証言のうそを見抜くリアルタイム反論ゲーム",
    description: "証拠と食い違う証言のチップを時間内にタップ！正しい証言は通し、うそだけ反論しましょう。30の裁判、だんだん速くなる証人。無料。",
  },
  zh: {
    title: "律师对时间 — 实时揪出证词谎言的法庭游戏",
    description: "在导火线烧完前，点出证词中与证据矛盾的那一格！真话放过，只反驳谎言。30场审判，证人越来越快。免费，无需安装。",
  },
  fr: {
    title: "Avocat contre le temps — repérez le mensonge en temps réel",
    description: "Touchez la pastille qui contredit les preuves avant la fin de la mèche. Laissez passer le vrai, objectez au faux. 30 procès, des témoins de plus en plus rapides. Gratuit.",
  },
  es: {
    title: "Abogado contra el tiempo — atrapa la mentira en tiempo real",
    description: "Toca la ficha que contradice las pruebas antes de que se consuma la mecha. Deja pasar lo cierto, objeta lo falso. 30 juicios, testigos cada vez más rápidos. Gratis.",
  },
};

const m = meta[locale] ?? meta.en;
---

<BaseLayout title={m.title} description={m.description} heading={m.title} image="/assets/sprites/time-counsel/keyart.webp">
  <div class="mx-auto max-w-7xl px-0 py-2 sm:px-4 sm:py-6">
    <TimeCounsel client:load locale={locale} />
    <div class="mx-auto max-w-3xl px-4 mt-8">
      <GameGuide slug="time-counsel" locale={locale} name={m.title.split(" — ")[0]} />
    </div>
  </div>
</BaseLayout>
